---
/**
 * LanguageToggle
 *
 * Segmented `EN | TR` button group in the header. The active segment
 * matches the current page's locale; clicking the other segment
 * navigates to the same page's localized counterpart.
 *
 * The alternate URL is computed at render time so a hard navigation
 * always lands the visitor on the matching page in the other locale
 * (e.g. /blog/welcome ↔ /tr/blog/welcome) instead of bouncing them
 * to the locale home.
 */
import type { Lang } from '@lib/i18n';
import { alternateUrl, t } from '@lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const otherHref = alternateUrl(currentPath, lang);
---

<div
  class="lang-toggle"
  role="group"
  aria-label={t('toggle.language', lang)}
>
  <a
    href={lang === 'en' ? currentPath : otherHref}
    class:list={['lang-pill', lang === 'en' && 'is-active']}
    aria-current={lang === 'en' ? 'true' : 'false'}
    data-lang="en"
  >
    EN
  </a>
  <a
    href={lang === 'tr' ? currentPath : otherHref}
    class:list={['lang-pill', lang === 'tr' && 'is-active']}
    aria-current={lang === 'tr' ? 'true' : 'false'}
    data-lang="tr"
  >
    TR
  </a>
</div>

<style>
  .lang-toggle {
    display: inline-flex;
    padding: 3px;
    border-radius: 10px;
    background: rgb(var(--bg-elev-2));
    font: 500 0.72rem/1 'JetBrains Mono', ui-monospace, monospace;
  }
  .lang-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 28px;
    padding: 0 8px;
    border-radius: 7px;
    color: rgb(var(--text-300));
    transition: color 0.2s, background 0.2s;
  }
  .lang-pill:hover {
    color: rgb(var(--text-100));
  }
  .lang-pill.is-active {
    color: rgb(var(--text-100));
    background: rgb(var(--bg-elev));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
</style>

<script>
  /**
   * Remember the user's last explicit choice. The URL is the source of
   * truth — this just lets us route a fresh visit to /tr/ if the user
   * picked Turkish last time and lands back on the site root.
   */
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const pill = target?.closest('[data-lang]') as HTMLElement | null;
    if (!pill) return;
    const v = pill.dataset.lang;
    if (v === 'en' || v === 'tr') {
      try {
        localStorage.setItem('fx-lang', v);
      } catch {
        /* storage blocked — non-fatal */
      }
    }
  });
</script>
