---
/**
 * FxToggle
 *
 * Single icon button in the header that toggles the custom cursor.
 * Defaults ON (opt-out — feels nicer to land with cursor on).
 *
 * Writes to localStorage and dispatches a CustomEvent so CustomCursor can
 * react without tight coupling.
 */
import { DEFAULT_LOCALE, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const labels = {
  en: { group: 'Effects', toggle: 'Toggle custom cursor', title: 'Custom cursor' },
  tr: { group: 'Efektler', toggle: 'Özel imleci aç/kapat', title: 'Özel imleç' },
}[lang];
---

<div class="flex items-center" aria-label={labels.group}>
  <button
    type="button"
    class="fx-btn"
    data-fx="cursor"
    aria-pressed="false"
    aria-label={labels.toggle}
    title={labels.title}
  >
    {/* Crosshair / cursor icon */}
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="3" />
      <circle cx="12" cy="12" r="9" />
      <line x1="12" y1="1" x2="12" y2="5" />
      <line x1="12" y1="19" x2="12" y2="23" />
      <line x1="1" y1="12" x2="5" y2="12" />
      <line x1="19" y1="12" x2="23" y2="12" />
    </svg>
  </button>
</div>

<style>
  .fx-btn {
    @apply inline-flex items-center justify-center w-7 h-7 border border-border text-text-300 transition-colors;
  }
  .fx-btn:hover {
    @apply text-text-100;
  }
  .fx-btn[aria-pressed='true'] {
    @apply text-accent-1 border-accent-1;
  }
</style>

<script>
  import { FX_EVENTS, FX_STORAGE } from '@lib/fx-events';

  const DEFAULT_ON = true; // cursor defaults on
  let memoryState: 'on' | 'off' | null = null;

  function getState(): boolean {
    // Check the in-memory state first. Brave's strict Shields silently
    // no-op localStorage.setItem (no throw, no actual write), so reading
    // localStorage afterwards returns null and we'd fall back to the
    // default — making the toggle look stuck. memoryState reflects the
    // user's last click regardless of whether storage took.
    if (memoryState === 'on') return true;
    if (memoryState === 'off') return false;
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(FX_STORAGE.cursor);
    } catch {
      /* storage blocked — defaults below */
    }
    if (stored === 'on') return true;
    if (stored === 'off') return false;
    return DEFAULT_ON;
  }

  function setState(on: boolean) {
    memoryState = on ? 'on' : 'off';
    try {
      localStorage.setItem(FX_STORAGE.cursor, memoryState);
    } catch {
      // Storage blocked — keep going with memoryState so the UI still toggles.
    }
    document.dispatchEvent(
      new CustomEvent(FX_EVENTS.cursorChanged, { detail: { on } })
    );
  }

  function syncButton(btn: HTMLButtonElement) {
    btn.setAttribute('aria-pressed', getState() ? 'true' : 'false');
  }

  type Guarded = HTMLButtonElement & { __fxInited?: boolean };

  function init() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.fx-btn');
    buttons.forEach((btn) => {
      // init() runs at module load AND on astro:page-load. Without a per-
      // button guard each click handler would be bound twice on the same
      // element, so a single click would fire setState(!getState()) twice
      // and the state would round-trip back to where it started — making
      // the toggle look stuck (especially visible in Brave's timing).
      if ((btn as Guarded).__fxInited) {
        syncButton(btn);
        return;
      }
      (btn as Guarded).__fxInited = true;
      syncButton(btn);
      btn.addEventListener('click', () => {
        setState(!getState());
        syncButton(btn);
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
