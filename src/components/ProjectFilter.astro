---
/**
 * Pills above the /projects grid: All | Products & Web | Games.
 *
 * Filtering is client-side: every card wrapper carries
 * `data-project-category`. The choice is mirrored in the URL as
 * `?type=products|games` so a filtered view is shareable.
 */
import { DEFAULT_LOCALE, t, type Lang } from '@lib/i18n';

interface Props {
  counts: { all: number; product: number; game: number };
  lang?: Lang;
}

const { counts, lang = DEFAULT_LOCALE } = Astro.props;

const pills = [
  { value: 'all', label: t('projectFilter.all', lang), n: counts.all },
  { value: 'product', label: t('projectFilter.products', lang), n: counts.product },
  { value: 'game', label: t('projectFilter.games', lang), n: counts.game },
].filter((p) => p.n > 0);
---

<div class="filter" data-project-filter role="group" aria-label={t('projectFilter.aria', lang)}>
  {
    pills.map((p) => (
      <button type="button" class="pill" data-value={p.value} aria-pressed={p.value === 'all' ? 'true' : 'false'}>
        {p.label}
        <span class="n">{p.n}</span>
      </button>
    ))
  }
</div>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgb(var(--border));
    color: rgb(var(--text-200));
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .pill:hover {
    color: rgb(var(--text-100));
  }
  .pill:focus-visible {
    outline: 2px solid rgb(var(--accent-1));
    outline-offset: 2px;
  }
  .pill[aria-pressed='true'] {
    color: rgb(var(--text-100));
    border-color: rgb(var(--accent-1) / 0.6);
    background: rgb(var(--accent-1) / 0.12);
  }
  .n {
    font: 0.72rem 'JetBrains Mono', ui-monospace, monospace;
    color: rgb(var(--text-300));
  }
  .pill[aria-pressed='true'] .n {
    color: rgb(var(--accent-1));
  }
</style>

<script>
  const TO_URL: Record<string, string> = { product: 'products', game: 'games' };

  function apply(filter: string) {
    document.querySelectorAll<HTMLElement>('[data-project-category]').forEach((card) => {
      card.hidden = filter !== 'all' && card.dataset.projectCategory !== filter;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-project-filter] .pill').forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.value === filter ? 'true' : 'false');
    });
  }

  function readFromUrl(): string {
    const q = new URL(location.href).searchParams.get('type');
    const hit = Object.entries(TO_URL).find(([, v]) => v === q);
    return hit && document.querySelector(`[data-project-filter] [data-value="${hit[0]}"]`) ? hit[0] : 'all';
  }

  function writeToUrl(filter: string) {
    const u = new URL(location.href);
    if (filter === 'all') u.searchParams.delete('type');
    else u.searchParams.set('type', TO_URL[filter]);
    history.replaceState(history.state, '', u);
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-project-filter]');
    if (!root) return;
    apply(readFromUrl());
    root.querySelectorAll<HTMLButtonElement>('.pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = btn.dataset.value ?? 'all';
        apply(v);
        writeToUrl(v);
      });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
