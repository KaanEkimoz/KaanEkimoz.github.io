---
/** Short first-person stories from building Patimania (source: the project page). */
import { copy, pick } from '@lib/home';
import type { Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.notes;
---

<section class="sec" id="notes">
  <div class="wrap">
    <div class="sec-head" data-fade-in>
      <h2>{pick(c.title, lang)}</h2>
      <p>{pick(c.lede, lang)}</p>
    </div>
    <ol class="notes" data-fade-in>
      {c.items.map((it) => (
        <li>
          <h3>{pick(it.h, lang)}</h3>
          <p>{pick(it.p, lang)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }
  li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 22px 0 26px;
    border-top: 1px solid rgb(var(--border));
  }
  h3 {
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 500;
  }
  p {
    color: rgb(var(--text-200));
    line-height: 1.6;
  }
  @media (max-width: 760px) {
    .notes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
