---
import { copy, pick } from '@lib/home';
import type { Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.method;
---

<section class="sec" id="method">
  <div class="wrap">
    <div class="sec-head" data-fade-in>
      <span class="eyebrow">{pick(c.eyebrow, lang)}</span>
      <h2 set:html={pick(c.title, lang)} />
    </div>
    <div class="method" data-fade-in>
      {c.items.map((it) => (
        <div>
          <span class="eyebrow k">{pick(it.k, lang)}</span>
          <h3>{pick(it.h, lang)}</h3>
          <p>{pick(it.p, lang)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .method {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgb(var(--border));
  }
  .method div {
    padding: 24px 24px 8px 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .method div + div {
    padding-left: 24px;
    border-left: 1px solid rgb(var(--border));
  }
  .k {
    color: rgb(var(--accent-1));
  }
  h3 {
    font-size: 1.2rem;
    line-height: 1.25;
    font-weight: 500;
  }
  p {
    color: rgb(var(--text-200));
    font-size: 0.96rem;
  }
  @media (max-width: 860px) {
    .method {
      grid-template-columns: 1fr;
    }
    .method div,
    .method div + div {
      padding: 20px 0;
      border-left: 0;
      border-bottom: 1px solid rgb(var(--border));
    }
  }
</style>
