---
/** How I use AI: the paragraph beside the heading, then the animated map of my AI studio across the full width. */
import AIStudio from '@components/home/AIStudio.astro';
import { copy, pick } from '@lib/home';
import type { Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.method;
---

<section class="sec" id="method">
  <div class="wrap method">
    <div class="copy" data-fade-in>
      <h2>{pick(c.title, lang)}</h2>
      {c.body.map((p) => <p>{pick(p, lang)}</p>)}
    </div>
    <AIStudio lang={lang} />
  </div>
</section>

<style>
  .method {
    display: grid;
    gap: 36px;
  }
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: start;
  }
  h2 {
    font-size: clamp(1.9rem, 3.8vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  p {
    color: rgb(var(--text-100));
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
    line-height: 1.6;
    max-width: 40rem;
  }
  @media (max-width: 860px) {
    .copy {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .method {
      gap: 28px;
    }
  }
</style>
