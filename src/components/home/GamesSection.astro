---
/** Where I started: the games, as a row of project cards beside a short intro. */
import { Image } from 'astro:assets';
import { copy, pick } from '@lib/home';
import { getProjects, slugOf } from '@lib/content';
import { localizedPath, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.games;
const games = (await getProjects(lang)).filter((p) => p.data.category === 'game');
---

<section class="sec" id="games">
  <div class="wrap layout">
    <div class="intro" data-fade-in>
      <h2>{pick(c.title, lang)}</h2>
      <p>{pick(c.lede, lang)}</p>
      <a class="btn btn-ghost" href={localizedPath('/projects', lang)}>{pick(c.all, lang)} →</a>
    </div>
    <div class="row" data-fade-in>
      {games.map((g) => (
        <a class="card" href={localizedPath(`/projects/${slugOf(g.id)}`, lang)} data-project-modal>
          <div class="img">
            {g.data.coverImage && (
              <Image src={g.data.coverImage} alt="" widths={[320, 640]} sizes="260px" style={g.data.coverPosition ? `object-position:${g.data.coverPosition}` : undefined} />
            )}
          </div>
          <div class="body">
            <b>{g.data.title}<span aria-hidden="true">↗</span></b>
            <p>{g.data.description}</p>
            <div class="tags">
              <span>{g.data.platform}</span>
              <span>{g.data.year}</span>
              {g.data.genres[0] && <span>{g.data.genres[0]}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.32fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .intro {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 90px;
  }
  h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .intro p {
    color: rgb(var(--text-200));
  }
  .row {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .card {
    flex: none;
    width: 260px;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--bg-elev));
    scroll-snap-align: start;
    transition: border-color 0.2s, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover {
    border-color: rgb(var(--accent-1) / 0.55);
    transform: translateY(-2px);
  }
  .img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgb(var(--bg-elev-2));
    border-bottom: 1px solid rgb(var(--border));
  }
  .img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 14px;
  }
  b {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font: 500 1rem Sora, ui-sans-serif, sans-serif;
    letter-spacing: -0.02em;
    color: rgb(var(--text-100));
  }
  b span {
    color: rgb(var(--text-300));
  }
  .card:hover b span {
    color: rgb(var(--accent-2));
  }
  .body p {
    font-size: 0.84rem;
    color: rgb(var(--text-200));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags span {
    font-size: 0.74rem;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid rgb(var(--border));
    color: rgb(var(--text-200));
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .intro {
      position: static;
    }
    .card {
      width: 230px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
