---
/**
 * My Projects: every project on an endless strip that drifts sideways,
 * wide and square cards taking turns (Patimania opens as a wide one).
 * With an odd number of projects one lap covers the list twice, so each
 * project appears in both shapes and the alternation never breaks at the
 * seam. The lap is rendered twice and the track slides by exactly one lap.
 * Hover or focus pauses it; with reduced motion it becomes a scroll row.
 * It can be dragged and flung with a finger or the mouse (it drifts on
 * again after a pause); touch screens also get a progress bar and a
 * "Swipe" hint below it.
 */
import { Image } from 'astro:assets';
import { copy, pick } from '@lib/home';
import { getProjects, slugOf } from '@lib/content';
import { localizedPath, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.projects;
const projects = (await getProjects(lang)).filter((p) => p.data.coverImage);
const passes = projects.length % 2 ? 2 : 1;
const lap = Array.from({ length: passes }, (_, k) => projects.map((p, i) => ({ p, wide: (i + k) % 2 === 0 }))).flat();
---

<section class="sec" id="projects">
  <div class="wrap head" data-fade-in>
    <h2>{pick(c.title, lang)}</h2>
    <a class="btn btn-ghost" href={localizedPath('/projects', lang)}>{pick(c.all, lang)} →</a>
  </div>
  <div class="strip" data-strip>
    <div class="track">
      {[0, 1].map((copyIdx) => (
        <ul class="lap" aria-hidden={copyIdx ? 'true' : undefined}>
          {lap.map(({ p, wide }) => {
            const cover = p.data.coverImage!;
            const square = !wide && p.data.coverSquare;
            const pos = p.data.coverPosition ? `object-position:${p.data.coverPosition}` : undefined;
            return (
              <li class:list={['card', wide ? 'wide' : 'sq']}>
                <a href={localizedPath(`/projects/${slugOf(p.id)}`, lang)} data-project-modal tabindex={copyIdx ? -1 : undefined}>
                  <div class="img">
                    {wide ? (
                      <Image src={cover} alt="" widths={[560, 1120]} sizes="560px" style={pos} />
                    ) : square ? (
                      <Image src={square} alt="" widths={[320, 640]} sizes="320px" />
                    ) : (
                      <>
                        <Image class="blur" src={cover} alt="" widths={[320]} sizes="320px" />
                        <Image class="whole" src={cover} alt="" widths={[320, 640]} sizes="320px" />
                      </>
                    )}
                  </div>
                  <div class="cap">
                    <b>{p.data.title}</b>
                    <span>{p.data.platform} · {p.data.year}</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ))}
    </div>
  </div>
  <div class="wrap swipe" data-swipe hidden>
    <span class="bar"><i></i></span>
    <span class="hint">{pick(c.swipe, lang)} <b aria-hidden="true">→</b></span>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .strip {
    --h: 300px;
    --gap: 18px;
    overflow: hidden;
    padding: 6px 0 4px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  /* The first card lines up with the heading; the loop slides by one lap
     of the track's own width, so this margin doesn't touch the seam. */
  .track {
    display: flex;
    width: max-content;
    margin-left: max(20px, calc((100vw - 72rem) / 2 + 20px));
    animation: drift var(--dur, 140s) linear infinite;
  }
  .strip:hover .track,
  .strip:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }
  .lap {
    display: flex;
    gap: var(--gap);
    padding-right: var(--gap);
  }
  .card a {
    display: grid;
    gap: 10px;
  }
  .img {
    position: relative;
    height: var(--h);
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--bg-elev-2));
    transition: border-color 0.2s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .wide .img {
    width: calc(var(--h) * 16 / 9);
  }
  .sq .img {
    width: var(--h);
  }
  .img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .img :global(.blur) {
    filter: blur(18px) brightness(0.7) saturate(1.2);
    transform: scale(1.2);
  }
  .img :global(.whole) {
    object-fit: contain;
  }
  .card a:hover .img,
  .card a:focus-visible .img {
    border-color: rgb(var(--accent-1) / 0.6);
    transform: translateY(-3px);
  }
  .cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 0 4px;
  }
  .cap b {
    font: 500 0.98rem Sora, ui-sans-serif, sans-serif;
    letter-spacing: -0.02em;
    color: rgb(var(--text-100));
  }
  .cap span {
    font: 0.74rem 'JetBrains Mono', ui-monospace, monospace;
    color: rgb(var(--text-300));
    white-space: nowrap;
  }
  .card a:hover .cap b {
    color: rgb(var(--accent-2));
  }
  @media (max-width: 860px) {
    .strip {
      --h: 196px;
      --gap: 12px;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent);
      mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 16px), transparent);
    }
  }
  /* The script moves the track and the strip takes horizontal drags. */
  .strip.js {
    touch-action: pan-y;
    user-select: none;
  }
  .strip.js .track {
    animation: none;
    will-change: transform;
  }
  .strip.js :global(:is(img, a)) {
    -webkit-user-drag: none;
  }
  .swipe {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
  }
  .swipe[hidden] {
    display: none;
  }
  .bar {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: rgb(var(--border));
    overflow: hidden;
  }
  .bar i {
    display: block;
    width: 28%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(var(--accent-1)), rgb(var(--accent-2)));
    transform: translateX(calc(var(--p, 0) * 257%));
  }
  .hint {
    font: 500 0.78rem 'JetBrains Mono', ui-monospace, monospace;
    color: rgb(var(--text-200));
    white-space: nowrap;
    transition: opacity 0.4s;
  }
  .hint b {
    display: inline-block;
    color: rgb(var(--accent-1));
    animation: nudge 1.4s ease-in-out infinite;
  }
  .swipe.used .hint {
    opacity: 0;
  }
  @keyframes nudge {
    50% {
      transform: translateX(5px);
    }
  }
  .swipe.no-hint .hint {
    display: none;
  }
  /* Reduced motion: a plain scroll row. The bar below stands in for the
     native scrollbar, which would otherwise show as a second slider. */
  @media (prefers-reduced-motion: reduce) {
    .strip {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .strip::-webkit-scrollbar {
      display: none;
    }
    .strip.grab {
      user-select: none;
    }
    .strip :global(:is(img, a)) {
      -webkit-user-drag: none;
    }
    .track {
      animation: none;
      padding-right: 20px;
    }
    .lap[aria-hidden] {
      display: none;
    }
    .img {
      transition: none;
    }
  }
</style>

<script>
  // Same drift speed on every screen: the duration follows the lap width.
  const SPEED = 42; // px per second
  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    const strip = document.querySelector<HTMLElement>('[data-strip]');
    const track = strip?.querySelector<HTMLElement>('.track');
    const lap = strip?.querySelector<HTMLElement>('.lap');
    const swipe = document.querySelector<HTMLElement>('[data-swipe]');
    if (!strip || !track || !lap || !swipe) return;
    strip.style.setProperty('--dur', `${(lap.offsetWidth / SPEED).toFixed(1)}s`);
    const touch = matchMedia('(hover: none)').matches;

    // Touch: show the hint; with reduced motion the row scrolls natively.
    swipe.hidden = !touch;
    const thumb = swipe.querySelector<HTMLElement>('.bar i')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // The row scrolls natively; the bar tracks it on every device and a
      // mouse can drag it (the "Swipe" hint stays touch-only).
      swipe.hidden = false;
      swipe.classList.toggle('no-hint', !touch);
      const onNative = () => thumb.style.setProperty('--p', String(strip.scrollLeft / Math.max(1, strip.scrollWidth - strip.clientWidth)));
      let fromX = -1, fromLeft = 0, dragged = 0;
      const down = (e: PointerEvent) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        fromX = e.clientX; fromLeft = strip.scrollLeft; dragged = 0;
      };
      const move = (e: PointerEvent) => {
        if (fromX < 0) return;
        dragged = Math.abs(e.clientX - fromX);
        if (dragged > 8) { strip.classList.add('grab'); strip.scrollLeft = fromLeft - (e.clientX - fromX); }
      };
      const up = () => { fromX = -1; strip.classList.remove('grab'); setTimeout(() => (dragged = 0), 0); };
      // A drag is not a tap (window capture runs before the project modal).
      const click = (e: MouseEvent) => {
        if (dragged > 8 && strip.contains(e.target as Node)) { e.preventDefault(); e.stopImmediatePropagation(); }
      };
      const noDrag = (e: DragEvent) => e.preventDefault();
      strip.addEventListener('scroll', onNative, { passive: true });
      strip.addEventListener('pointerdown', down);
      strip.addEventListener('dragstart', noDrag);
      addEventListener('pointermove', move, { passive: true });
      addEventListener('pointerup', up);
      addEventListener('click', click, true);
      cleanup = () => {
        strip.removeEventListener('scroll', onNative);
        strip.removeEventListener('pointerdown', down);
        strip.removeEventListener('dragstart', noDrag);
        removeEventListener('pointermove', move);
        removeEventListener('pointerup', up);
        removeEventListener('click', click, true);
        cleanup = null;
      };
      return;
    }

    strip.classList.add('js');
    let off = 0, vel = SPEED, raf = 0, last = 0, visible = false, held = false;
    let dragging = false, lastX = 0, lastT = 0, moved = 0, resumeAt = 0;
    const lapW = () => lap.offsetWidth;
    const tick = (t: number) => {
      const dt = last ? Math.min(0.05, (t - last) / 1000) : 0; last = t;
      if (!dragging) {
        // A fling slows with friction; after a pause the drift eases back in.
        // A mouse over the strip (or focus inside it) holds it still.
        if (held || strip.querySelector(':focus-visible')) vel *= Math.pow(held && t >= resumeAt ? 1e-4 : 0.04, dt);
        else if (t < resumeAt) vel *= Math.pow(0.04, dt);
        else vel += (SPEED - vel) * Math.min(1, dt * 1.5);
        off += vel * dt;
      }
      const w = lapW();
      off = ((off % w) + w) % w;
      track.style.transform = `translate3d(${-off}px,0,0)`;
      thumb.style.setProperty('--p', (off / w).toFixed(4));
      raf = visible ? requestAnimationFrame(tick) : 0;
    };
    const start = () => { if (!raf && visible) { last = 0; raf = requestAnimationFrame(tick); } };
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); });
    io.observe(strip);

    const down = (e: PointerEvent) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true; moved = 0; vel = 0; lastX = e.clientX; lastT = e.timeStamp;
      start();
    };
    const move = (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - lastX, dt = Math.max(1, e.timeStamp - lastT) / 1000;
      off -= dx; moved += Math.abs(dx);
      vel = vel * 0.6 + (-dx / dt) * 0.4;
      lastX = e.clientX; lastT = e.timeStamp;
      if (moved > 8) swipe.classList.add('used');
    };
    const up = () => {
      if (!dragging) return;
      dragging = false; resumeAt = performance.now() + 2600;
    };
    // A drag is not a tap: keep it from opening the project. Window capture
    // runs before the project modal's own document-level click handler.
    const click = (e: MouseEvent) => {
      if (moved > 8 && strip.contains(e.target as Node)) { e.preventDefault(); e.stopImmediatePropagation(); }
    };
    // Native link/image drag would show the system cursor and steal the gesture.
    const noDrag = (e: DragEvent) => e.preventDefault();
    const enter = (e: PointerEvent) => { if (e.pointerType === 'mouse') held = true; };
    const leave = (e: PointerEvent) => { if (e.pointerType === 'mouse') { held = false; start(); } };
    strip.addEventListener('dragstart', noDrag);
    strip.addEventListener('pointerenter', enter);
    strip.addEventListener('pointerleave', leave);
    strip.addEventListener('focusout', start);
    strip.addEventListener('pointerdown', down);
    addEventListener('pointermove', move, { passive: true });
    addEventListener('pointerup', up);
    addEventListener('pointercancel', up);
    addEventListener('click', click, true);

    cleanup = () => {
      io.disconnect(); cancelAnimationFrame(raf);
      strip.removeEventListener('pointerdown', down);
      removeEventListener('pointermove', move);
      removeEventListener('pointerup', up);
      removeEventListener('pointercancel', up);
      removeEventListener('click', click, true);
      strip.removeEventListener('dragstart', noDrag);
      strip.removeEventListener('pointerenter', enter);
      strip.removeEventListener('pointerleave', leave);
      strip.removeEventListener('focusout', start);
      strip.classList.remove('js'); track.style.transform = '';
      cleanup = null;
    };
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
