---
import { copy, EVALS, pick } from '@lib/home';
import type { Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.evals;
const top = (v: number) => (lang === 'tr' ? `ilk %${100 - v}` : `top ${100 - v}%`);
---

<section class="sec" id="evals">
  <div class="wrap">
    <div class="sec-head" data-fade-in>
      <h2>{pick(c.title, lang)}</h2>
    </div>
    <div class="evals panel" data-fade-in data-evals>
      <table>
        <thead>
          <tr>
            <th>{pick(c.assessment, lang)}</th>
            <th>{pick(c.percentile, lang)}</th>
            <th class="axis" aria-hidden="true"><div class="scale"><span>0</span><span>50</span><span>90</span><span>100</span></div></th>
          </tr>
        </thead>
        <tbody>
          {EVALS.map((e) => (
            <tr>
              <td>{pick(e.name, lang)}</td>
              <td class="pct"><b>{e.value}</b><small>{top(e.value)}</small></td>
              <td class="axis">
                <div class="track"><b style="left:50%"></b><b style="left:90%"></b><span class="zone"></span><i style={`left:${e.value}%`} data-v={e.value}></i></div>
              </td>
            </tr>
          ))}
        </tbody>
        <caption>{pick(c.caption, lang)}</caption>
      </table>
    </div>
  </div>
</section>

<style>
  .evals {
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th {
    text-align: left;
    padding: 14px 20px;
    border-bottom: 1px solid rgb(var(--border));
    font: 500 0.7rem 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text-300));
  }
  td {
    padding: 14px 20px;
    border-bottom: 1px solid rgb(var(--border));
    font-size: 0.95rem;
    color: rgb(var(--text-100));
  }
  tr:last-child td {
    border-bottom: 0;
  }
  .pct {
    width: 7rem;
  }
  .pct b {
    font: 500 1.35rem Sora, ui-sans-serif, sans-serif;
    letter-spacing: -0.03em;
  }
  .pct small {
    display: block;
    font: 500 0.68rem 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.06em;
    color: rgb(var(--accent-2));
  }
  .axis {
    width: 48%;
  }
  .scale {
    position: relative;
    height: 12px;
  }
  .scale span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font: 500 0.66rem 'JetBrains Mono', ui-monospace, monospace;
    color: rgb(var(--text-300));
  }
  .scale span:nth-child(1) { left: 0; transform: none; }
  .scale span:nth-child(2) { left: 50%; }
  .scale span:nth-child(3) { left: 90%; }
  .scale span:nth-child(4) { left: 100%; transform: translateX(-100%); }
  .track {
    position: relative;
    height: 18px;
  }
  .track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgb(var(--border));
  }
  .track b {
    position: absolute;
    top: 50%;
    width: 1px;
    height: 7px;
    margin-top: -3px;
    background: rgb(var(--border));
  }
  .zone {
    position: absolute;
    top: 50%;
    left: 90%;
    right: 0;
    height: 3px;
    margin-top: -1px;
    border-radius: 2px;
    background: rgb(var(--accent-1) / 0.25);
  }
  .track i {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: rgb(var(--accent-2));
    box-shadow: 0 0 0 4px rgb(var(--accent-2) / 0.15), 0 0 14px rgb(var(--accent-2));
    transition: left 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  caption {
    caption-side: bottom;
    text-align: left;
    padding: 12px 20px 16px;
    font-size: 0.8rem;
    color: rgb(var(--text-300));
    border-top: 1px solid rgb(var(--border));
  }
  @media (max-width: 860px) {
    .axis {
      display: none;
    }
    th,
    td {
      padding: 12px 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track i {
      transition: none;
    }
  }
</style>

<script>
  // Dots start at 0 and travel to their percentile the first time the table is seen.
  function init() {
    const box = document.querySelector<HTMLElement>('[data-evals]');
    if (!box || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (box.getBoundingClientRect().top < innerHeight) return;
    const dots = [...box.querySelectorAll<HTMLElement>('.track i')];
    dots.forEach((d) => (d.style.left = '0%'));
    const io = new IntersectionObserver((es) => {
      if (!es[0].isIntersecting) return;
      dots.forEach((d, k) => setTimeout(() => (d.style.left = `${d.dataset.v}%`), k * 90));
      io.disconnect();
    }, { threshold: 0.4 });
    io.observe(box);
  }
  document.addEventListener('astro:page-load', init);
</script>
