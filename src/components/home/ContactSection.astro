---
import { SOCIAL } from '@lib/constants';
import BrandIcon from '@components/BrandIcon.astro';
import { copy, pick } from '@lib/home';
import type { Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy.contact;
const socials = [
  { name: 'GitHub', icon: 'siGithub', href: SOCIAL.github },
  { name: 'LinkedIn', icon: 'linkedin', href: SOCIAL.linkedin },
  { name: 'YouTube', icon: 'siYoutube', href: SOCIAL.youtube },
  { name: 'itch.io', icon: 'siItchdotio', href: SOCIAL.itchio },
];
---

<section class="contact" id="contact">
  <div class="wrap grid">
    <div class="lead">
      <h2>{pick(c.title, lang)}</h2>
      <p class="lede">{pick(c.lede, lang)}</p>
      <a class="btn" href={`mailto:${SOCIAL.email}`}>{pick(c.send, lang)} →</a>
    </div>

    <ul class="ways">
      <li>
        <span class="ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span>
        <div>
          <small>{pick(c.email, lang)}</small>
          <div class="mail">
            <a href={`mailto:${SOCIAL.email}`} data-email>{SOCIAL.email}</a>
            <button class="copy" type="button" data-copy data-copied={pick(c.copied, lang)} data-selected={pick(c.selected, lang)}>{pick(c.copy, lang)}</button>
          </div>
        </div>
      </li>
      <li>
        <span class="ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg></span>
        <div>
          <small>{pick(c.location, lang)}</small>
          <p>{pick(c.place, lang)}</p>
        </div>
      </li>
      <li>
        <span class="ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="6" r="2.5"></circle><circle cx="18" cy="18" r="2.5"></circle><path d="m8.2 10.9 7.6-3.8M8.2 13.1l7.6 3.8"></path></svg></span>
        <div>
          <small>{pick(c.socials, lang)}</small>
          <p class="socials">
            {socials.map((x) => (
              <a href={x.href} target="_blank" rel="noopener" aria-label={x.name} title={x.name}><BrandIcon name={x.icon} size={20} color={false} /></a>
            ))}
          </p>
        </div>
      </li>
    </ul>

    <p class="hand note">{pick(c.note, lang)}</p>
  </div>
</section>

<style>
  .contact {
    margin-top: clamp(88px, 10vw, 128px);
    padding-block: clamp(64px, 9vw, 112px);
    border-top: 1px solid rgb(var(--border));
    scroll-margin-top: 60px;
    background: radial-gradient(70% 90% at 85% 100%, rgb(var(--accent-1) / 0.1), transparent 70%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.5fr);
    gap: 48px;
    align-items: center;
  }
  .lead {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  h2 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    font-weight: 500;
    max-width: 12ch;
  }
  .lede {
    color: rgb(var(--text-200));
    font-size: 1.08rem;
    max-width: 30rem;
  }
  .ways {
    display: grid;
    gap: 22px;
  }
  .ways li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--bg-elev));
    color: rgb(var(--accent-1));
  }
  small {
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgb(var(--accent-1));
    margin-bottom: 2px;
  }
  .ways p {
    color: rgb(var(--text-100));
  }
  .mail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .mail a {
    color: rgb(var(--text-100));
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .mail a:hover {
    color: rgb(var(--accent-2));
  }
  .copy {
    font-size: 0.8rem;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid rgb(var(--border));
    color: rgb(var(--text-200));
  }
  .copy:hover {
    color: rgb(var(--text-100));
    border-color: rgb(var(--accent-1));
  }
  .socials {
    display: flex;
    gap: 14px;
    margin-top: 4px;
  }
  .socials a {
    color: rgb(var(--text-200));
    transition: color 0.2s;
  }
  .socials a:hover {
    color: rgb(var(--accent-2));
  }
  .note {
    justify-self: end;
    max-width: 10ch;
    text-align: right;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .note {
      justify-self: start;
      text-align: left;
      max-width: none;
    }
  }
</style>

<script>
  function init() {
    const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
    const email = document.querySelector<HTMLElement>('[data-email]');
    if (!btn || !email || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email.textContent || '');
        btn.textContent = btn.dataset.copied || '';
      } catch {
        getSelection()?.selectAllChildren(email);
        btn.textContent = btn.dataset.selected || '';
      }
      setTimeout(() => (btn.textContent = label), 1600);
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
