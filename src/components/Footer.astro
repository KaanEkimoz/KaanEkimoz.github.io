---
import { SITE, SOCIAL } from '@lib/constants';
import { DEFAULT_LOCALE, t, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <span>© {year} {SITE.author}</span>
    <nav aria-label={t('footer.links', lang)}>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>
      <a href={lang === 'tr' ? '/tr/rss.xml' : '/rss.xml'}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgb(var(--border));
    color: rgb(var(--text-300));
    font-size: 0.82rem;
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 26px max(20px, env(safe-area-inset-right, 0px)) 26px max(20px, env(safe-area-inset-left, 0px));
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
  }
  nav {
    display: flex;
    gap: 18px;
  }
  a {
    padding-block: 6px;
  }
  a:hover {
    color: rgb(var(--text-100));
  }
</style>
