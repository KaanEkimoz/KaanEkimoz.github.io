---
/**
 * Small mono chip. Utility classes only (no scoped CSS) so it still looks
 * right when the project detail page is injected into the project modal.
 */
interface Props {
  variant?: 'accent' | 'muted';
}

const { variant = 'muted' } = Astro.props;

const variants = {
  accent: 'border-accent-1/40 text-accent-1 bg-accent-1/10',
  muted: 'border-border text-text-200',
} as const;
---

<span class:list={['inline-block px-2 py-0.5 border rounded-md font-mono text-[11px]', variants[variant]]}>
  <slot />
</span>
