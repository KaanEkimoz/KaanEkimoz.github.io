---
/**
 * CustomCursor
 *
 * Renders a two-part cursor (dot + ring) that follows the mouse with subtle
 * lag on the ring. Enables on desktop only (skipped on touch / coarse pointer).
 * Toggle via FxToggle (writes localStorage 'fx-cursor' = 'on' | 'off' and
 * dispatches CustomEvent('fx:cursor-changed', { detail: { on } })).
 *
 * Removable in one step: delete this component + its <CustomCursor /> usage
 * + the cursor toggle in FxToggle.astro.
 */
---

<div class="cursor-dot" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"></div>

<style is:global>
  /* Hide native cursor only when FX cursor is active */
  html.fx-cursor-on,
  html.fx-cursor-on * {
    cursor: none !important;
  }

  .cursor-dot,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    will-change: transform;
    opacity: 0;
    transition: opacity 0.2s;
  }

  html.fx-cursor-on .cursor-dot,
  html.fx-cursor-on .cursor-ring {
    opacity: 1;
  }

  /* When the pointer is over an iframe (YouTube embed, etc.), the iframe
     captures mousemove and our ring/dot would otherwise freeze in place
     while the iframe shows its own native cursor — giving a stale ghost
     in the corner. Hide the custom cursor entirely while inside an iframe;
     also let the iframe show its own cursor by allowing the native one. */
  html.fx-cursor-over-iframe .cursor-dot,
  html.fx-cursor-over-iframe .cursor-ring {
    opacity: 0;
  }
  html.fx-cursor-on.fx-cursor-over-iframe iframe {
    cursor: auto !important;
  }

  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--accent-1);
    border-radius: 50%;
  }

  .cursor-ring {
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px;
    border: 1px solid var(--accent-1);
    border-radius: 50%;
    transition: width 0.18s, height 0.18s, margin 0.18s, border-color 0.18s,
      background 0.18s, opacity 0.2s;
  }

  .cursor-ring.cursor-ring-hover {
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border-color: var(--accent-2);
    background: rgba(255, 77, 255, 0.08);
  }

  /* Hide on touch devices (no hover support) */
  @media (hover: none), (pointer: coarse) {
    .cursor-dot,
    .cursor-ring {
      display: none !important;
    }
  }
</style>

<script>
  import { FX_EVENTS, FX_STORAGE } from '@lib/fx-events';

  // Custom cursor controller — runs once per page load (re-bound by ClientRouter)

  function isCoarsePointer() {
    return matchMedia('(hover: none), (pointer: coarse)').matches;
  }

  function getEnabled(): boolean {
    if (isCoarsePointer()) return false;
    // Brave's Shields / Safari's ITP can throw on storage access. Falling back
    // to the default (on) is fine — without the guard the whole CustomCursor
    // module would crash at load and the ring/dot would never track at all.
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(FX_STORAGE.cursor);
    } catch {
      /* storage blocked */
    }
    return stored !== 'off';
  }

  function applyClass(on: boolean) {
    document.documentElement.classList.toggle('fx-cursor-on', on);
  }

  let dot: HTMLElement | null = null;
  let ring: HTMLElement | null = null;
  let mouseX = -100;
  let mouseY = -100;
  let ringX = -100;
  let ringY = -100;
  let rafId: number | null = null;

  function tick() {
    if (!ring) return;
    ringX += (mouseX - ringX) * 0.2;
    ringY += (mouseY - ringY) * 0.2;
    ring.style.transform = `translate(${ringX}px, ${ringY}px)`;
    rafId = requestAnimationFrame(tick);
  }

  function onMove(e: MouseEvent) {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (dot) dot.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
  }

  function onOver(e: Event) {
    const target = e.target as HTMLElement;
    if (target.closest('a, button, [role="button"]')) {
      ring?.classList.add('cursor-ring-hover');
    }
  }

  function onOut(e: Event) {
    const target = e.target as HTMLElement;
    if (target.closest('a, button, [role="button"]')) {
      ring?.classList.remove('cursor-ring-hover');
    }
  }

  function init() {
    dot = document.querySelector('.cursor-dot');
    ring = document.querySelector('.cursor-ring');
    applyClass(getEnabled());

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseover', onOver);
    document.addEventListener('mouseout', onOut);

    if (rafId !== null) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(tick);
  }

  // Listen for toggle events from FxToggle
  document.addEventListener(FX_EVENTS.cursorChanged, ((e: CustomEvent) => {
    applyClass(Boolean(e.detail?.on));
  }) as EventListener);

  // Hide the custom cursor while the pointer is over any iframe — the iframe
  // (YouTube embed, etc.) captures mousemove on the inside, so without this
  // our dot/ring would freeze on the page edge while YouTube shows its own
  // native cursor inside the video.
  function onIframeEnter(e: Event) {
    if ((e.target as Element | null)?.tagName === 'IFRAME') {
      document.documentElement.classList.add('fx-cursor-over-iframe');
    }
  }
  function onIframeLeave(e: Event) {
    if ((e.target as Element | null)?.tagName === 'IFRAME') {
      document.documentElement.classList.remove('fx-cursor-over-iframe');
    }
  }
  document.addEventListener('mouseover', onIframeEnter);
  document.addEventListener('mouseout', onIframeLeave);

  init();
  // Re-init on Astro client-side navigation
  document.addEventListener('astro:page-load', init);
</script>
