---
import { SOCIAL } from '@lib/constants';
import { DEFAULT_LOCALE, t, type Lang } from '@lib/i18n';

interface Props {
  /** Optional list of channels to render (in order). Defaults to all. */
  channels?: Array<keyof typeof links>;
  size?: 'sm' | 'md';
  lang?: Lang;
}

const links = {
  github: { label: 'GitHub', href: SOCIAL.github },
  linkedin: { label: 'LinkedIn', href: SOCIAL.linkedin },
  youtube: { label: 'YouTube', href: SOCIAL.youtube },
  itchio: { label: 'Itch.io', href: SOCIAL.itchio },
} as const;

const {
  channels = ['github', 'linkedin', 'youtube', 'itchio'],
  size = 'md',
  lang = DEFAULT_LOCALE,
} = Astro.props;

const sizeCls = size === 'sm' ? 'text-[10px]' : 'text-xs';
const newTab = t('social.newTab', lang);
---

<ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
  {
    channels.map((key) => {
      const item = links[key];
      return (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'font-mono uppercase tracking-widest text-text-300 hover:text-accent-1 transition-colors',
              sizeCls,
            ]}
            aria-label={`${item.label} (${newTab})`}
          >
            {item.label}
          </a>
        </li>
      );
    })
  }
</ul>
