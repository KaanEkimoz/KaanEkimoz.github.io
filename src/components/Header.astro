---
import { NAV } from '@lib/constants';
import ThemeToggle from '@components/ThemeToggle.astro';
import LanguageToggle from '@components/LanguageToggle.astro';
import Mark from '@components/Mark.astro';
import { DEFAULT_LOCALE, localizedPath, t, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LOCALE } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
const homeHref = localizedPath('/', lang);
---

<a class="skip" href="#main">{t('nav.skip', lang)}</a>
<header class="site-header">
  <div class="inner">
    <a href={homeHref} class="word" aria-label={`kaanusta.dev — ${t('nav.home', lang)}`}>
      <Mark size={18} />
      <span><span class="name">kaanusta</span><span class="dom">.dev</span></span>
    </a>

    <div class="right">
      <nav class="nav" aria-label={t('nav.main', lang)}>
        {
          NAV.map((item) => {
            const href = localizedPath(item.href, lang);
            return (
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                {t(`nav.${item.key}`, lang)}
              </a>
            );
          })
        }
      </nav>
      <LanguageToggle lang={lang} />
      <a class="cta" href={`${homeHref}#contact`}>{t('nav.contact', lang)}</a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: 8px;
    background: rgb(var(--accent-strong));
    color: #fff;
  }
  .skip:focus {
    top: 12px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(var(--bg-base) / 0.72);
    border-bottom: 1px solid rgb(var(--border));
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }
  .inner {
    max-width: 72rem;
    margin: 0 auto;
    height: 58px;
    padding-inline: max(20px, env(safe-area-inset-left, 0px)) max(20px, env(safe-area-inset-right, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .word {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 500 0.9rem/1 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.02em;
  }
  .word .name {
    color: rgb(var(--text-100));
  }
  .word .dom {
    color: rgb(var(--accent-1));
  }
  .right {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav {
    display: flex;
    gap: 2px;
    margin-right: 6px;
  }
  .nav a {
    font-size: 0.92rem;
    color: rgb(var(--text-200));
    padding: 7px 12px;
    border-radius: 10px;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: rgb(var(--text-100));
    background: rgb(var(--bg-elev-2));
  }
  .cta {
    height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    font-size: 0.86rem;
    font-weight: 500;
    color: #fff;
    background: rgb(var(--accent-strong));
    transition: transform 0.1s ease-out, filter 0.2s;
  }
  .cta:hover {
    filter: brightness(1.1);
  }
  .cta:active {
    transform: scale(0.96);
  }
  @media (max-width: 760px) {
    .inner {
      gap: 8px;
      padding-inline: max(14px, env(safe-area-inset-left, 0px)) max(14px, env(safe-area-inset-right, 0px));
    }
    .nav {
      margin-right: 0;
    }
    .nav a {
      padding: 8px 7px;
      font-size: 0.86rem;
    }
    .word {
      font-size: 0.8rem;
      gap: 6px;
    }
    .cta {
      display: none;
    }
  }
  /* Three nav items + toggles don't fit beside the wordmark on phones;
     keep only the mark there. */
  @media (max-width: 560px) {
    .word > span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (max-width: 359px) {
    .inner {
      gap: 4px;
    }
    .nav a {
      padding: 8px 4px;
      font-size: 0.78rem;
    }
    .right {
      gap: 2px;
    }
    .right :global(.lang-pill) {
      min-width: 28px;
      padding: 0 5px;
    }
    .right :global(.theme-btn) {
      width: 32px;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: rgb(var(--bg-base));
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
