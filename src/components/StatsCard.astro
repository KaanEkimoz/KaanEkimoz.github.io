---
import { STATS } from '@lib/constants';
import { DEFAULT_LOCALE, t, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LOCALE } = Astro.props;
---

<dl
  class="inline-block border border-accent-1/40 bg-bg-elev px-6 py-4 font-mono text-sm transition-shadow hover:shadow-glow-cyan"
>
  {
    STATS.map((s) => (
      <div class="flex gap-6">
        <dt class="text-text-300 w-24">{t(`stats.${s.key}`, lang)}</dt>
        <dd class="text-text-100">{s.value}</dd>
      </div>
    ))
  }
</dl>
