---
/**
 * LiteYouTube — facade for YouTube embeds.
 *
 * Renders only the poster image + a play button initially. The actual YouTube
 * iframe is only injected when the user clicks. Saves ~1.5 MB on initial page
 * load vs eager-embedded iframes.
 *
 * Usage: <LiteYouTube id="0KpRHhH52hQ" title="Orbs of The Power" />
 */
interface Props {
  id: string;
  title?: string;
}

const { id, title = 'YouTube video' } = Astro.props;

// Try maxres first, but it doesn't always exist for older videos. The component
// falls back to hqdefault on error via the inline onerror handler below.
const posterMax = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<lite-youtube data-id={id} data-title={title} class="lite-yt">
  <button type="button" aria-label={`Play: ${title}`} class="lite-yt-btn">
    <img
      src={posterMax}
      alt=""
      loading="lazy"
      decoding="async"
      data-fallback={posterFallback}
      onerror="this.onerror=null; this.src=this.dataset.fallback;"
    />
    <span class="lite-yt-play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48">
        <path
          d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
          fill="rgba(0, 217, 255, 0.85)"
        />
        <path d="M45 24 27 14v20" fill="#0a0a14" />
      </svg>
    </span>
  </button>
</lite-youtube>

<script>
  // Custom element — once defined, every <lite-youtube> uses this behavior.
  // Idempotent: define() is guarded so multiple imports + ClientRouter navigations
  // don't throw.
  class LiteYouTube extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector('button');
      if (!btn) return;
      btn.addEventListener(
        'click',
        () => {
          const id = this.dataset.id;
          const title = this.dataset.title || 'YouTube video';
          if (!id) return;
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(
            id
          )}?autoplay=1&rel=0`;
          iframe.title = title;
          iframe.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          iframe.setAttribute('frameborder', '0');
          // Inline styles — Astro scoped CSS won't reach dynamically created elements
          iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
          this.replaceChildren(iframe);
        },
        { once: true }
      );
    }
  }

  if (!customElements.get('lite-youtube')) {
    customElements.define('lite-youtube', LiteYouTube);
  }
</script>
