---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import LiteYouTube from '@components/LiteYouTube.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  platform,
  genres,
  year,
  duration,
  role,
  description,
  techStack,
  links,
  coverImage,
  gallery,
  youtubeId,
} = project.data;

const platformVariant =
  platform === 'Mobile' ? 'cyan' : platform === 'PC' ? 'magenta' : 'amber';
---

<BaseLayout title={title} description={description}>
  <article id="project-detail" class="max-w-3xl mx-auto px-6 py-16">
    <a
      href="/projects"
      class="inline-block font-mono text-xs uppercase tracking-widest text-text-300 hover:text-accent-1 mb-8"
    >
      ← Back to Projects
    </a>

    {/* Cover hero */}
    {
      coverImage && (
        <div class="mb-10 border border-border overflow-hidden">
          <Image
            src={coverImage}
            alt={`${title} cover image`}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 768px, 100vw"
            class="w-full h-auto"
          />
        </div>
      )
    }

    <header class="mb-10 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <Tag variant={platformVariant}>{platform}</Tag>
        {genres.map((g) => <Tag variant="muted">{g}</Tag>)}
        <Tag variant="muted">{year}</Tag>
      </div>
      <h1
        class="font-mono font-semibold text-4xl sm:text-5xl text-text-100 tracking-wide"
      >
        {title}
      </h1>
      <p class="mt-4 text-text-200 text-lg leading-relaxed">{description}</p>
    </header>

    {/* Video */}
    {
      youtubeId && (
        <div class="mb-12">
          <div class="font-mono text-xs uppercase tracking-widest text-text-300 mb-3">
            Gameplay
          </div>
          <LiteYouTube id={youtubeId} title={`${title} — gameplay`} />
        </div>
      )
    }

    <div class="grid sm:grid-cols-2 gap-6 mb-12 text-sm font-mono">
      <div>
        <div class="text-text-300 uppercase tracking-widest text-xs mb-1">
          Role
        </div>
        <div class="text-text-100">{role}</div>
      </div>
      <div>
        <div class="text-text-300 uppercase tracking-widest text-xs mb-1">
          Timeline
        </div>
        <div class="text-text-100">{duration}</div>
      </div>
      <div class="sm:col-span-2">
        <div class="text-text-300 uppercase tracking-widest text-xs mb-2">
          Tech Stack
        </div>
        <div class="flex flex-wrap gap-2">
          {techStack.map((t) => <Tag variant="muted">{t}</Tag>)}
        </div>
      </div>
    </div>

    {/* Links */}
    {
      (links.github || links.youtube || links.googlePlay || links.itchio) && (
        <div class="mb-12">
          <div class="font-mono text-xs uppercase tracking-widest text-text-300 mb-3">
            Links
          </div>
          <div class="flex flex-wrap gap-2">
            {links.github && (
              <Button href={links.github} variant="secondary" external>
                [ GitHub ]
              </Button>
            )}
            {links.youtube && (
              <Button href={links.youtube} variant="secondary" external>
                [ YouTube ]
              </Button>
            )}
            {links.googlePlay && (
              <Button href={links.googlePlay} variant="secondary" external>
                [ Play Store ]
              </Button>
            )}
            {links.itchio && (
              <Button href={links.itchio} variant="secondary" external>
                [ Itch.io ]
              </Button>
            )}
          </div>
        </div>
      )
    }

    {/* Markdown body */}
    <div class="prose-content space-y-4 text-text-200 leading-relaxed">
      <Content />
    </div>

    {/* Gallery */}
    {
      gallery && gallery.length > 0 && (
        <section class="mt-16 pt-10 border-t border-border">
          <h2 class="font-mono uppercase tracking-widest text-text-100 text-sm mb-6">
            <span class="text-accent-1">///</span> Screenshots
          </h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {gallery.map((img, i) => (
              <div class="border border-border overflow-hidden">
                <Image
                  src={img}
                  alt={`${title} screenshot ${i + 1}`}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="w-full h-auto"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
