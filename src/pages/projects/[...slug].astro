---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  platform,
  genres,
  year,
  duration,
  role,
  description,
  techStack,
  links,
} = project.data;

const platformVariant =
  platform === 'Mobile' ? 'cyan' : platform === 'PC' ? 'magenta' : 'amber';
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <a
      href="/projects"
      class="inline-block font-mono text-xs uppercase tracking-widest text-text-300 hover:text-accent-1 mb-8"
    >
      ← Back to Projects
    </a>

    <header class="mb-10 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <Tag variant={platformVariant}>{platform}</Tag>
        {genres.map((g) => <Tag variant="muted">{g}</Tag>)}
        <Tag variant="muted">{year}</Tag>
      </div>
      <h1
        class="font-mono font-semibold text-4xl sm:text-5xl text-text-100 tracking-wide"
      >
        {title}
      </h1>
      <p class="mt-4 text-text-200 text-lg leading-relaxed">{description}</p>
    </header>

    <div class="grid sm:grid-cols-2 gap-6 mb-12 text-sm font-mono">
      <div>
        <div class="text-text-300 uppercase tracking-widest text-xs mb-1">
          Role
        </div>
        <div class="text-text-100">{role}</div>
      </div>
      <div>
        <div class="text-text-300 uppercase tracking-widest text-xs mb-1">
          Timeline
        </div>
        <div class="text-text-100">{duration}</div>
      </div>
      <div class="sm:col-span-2">
        <div class="text-text-300 uppercase tracking-widest text-xs mb-2">
          Tech Stack
        </div>
        <div class="flex flex-wrap gap-2">
          {techStack.map((t) => <Tag variant="muted">{t}</Tag>)}
        </div>
      </div>
    </div>

    {/* Links */}
    {
      (links.github || links.youtube || links.googlePlay || links.itchio) && (
        <div class="mb-12">
          <div class="font-mono text-xs uppercase tracking-widest text-text-300 mb-3">
            Links
          </div>
          <div class="flex flex-wrap gap-2">
            {links.github && (
              <Button href={links.github} variant="secondary" external>
                [ GitHub ]
              </Button>
            )}
            {links.youtube && (
              <Button href={links.youtube} variant="secondary" external>
                [ YouTube ]
              </Button>
            )}
            {links.googlePlay && (
              <Button href={links.googlePlay} variant="secondary" external>
                [ Play Store ]
              </Button>
            )}
            {links.itchio && (
              <Button href={links.itchio} variant="secondary" external>
                [ Itch.io ]
              </Button>
            )}
          </div>
        </div>
      )
    }

    {/* Markdown body */}
    <div class="prose-content space-y-4 text-text-200 leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    @apply font-mono text-text-100 text-xl mt-10 mb-4 uppercase tracking-widest;
  }
  .prose-content h3 {
    @apply font-mono text-text-100 text-lg mt-8 mb-3;
  }
  .prose-content p {
    @apply text-text-200;
  }
  .prose-content ul {
    @apply list-disc list-inside space-y-2 text-text-200 marker:text-accent-1;
  }
  .prose-content ol {
    @apply list-decimal list-inside space-y-2 text-text-200 marker:text-accent-1;
  }
  .prose-content strong {
    @apply text-text-100;
  }
  .prose-content a {
    @apply text-accent-1 hover:underline underline-offset-4;
  }
  .prose-content code {
    @apply bg-bg-elev px-1.5 py-0.5 font-mono text-sm text-accent-1 border border-border;
  }
  .prose-content pre {
    @apply bg-bg-elev p-4 overflow-x-auto border border-border;
  }
  .prose-content pre code {
    @apply bg-transparent border-0 p-0 text-text-200;
  }
  .prose-content blockquote {
    @apply border-l-2 border-accent-1 pl-4 italic text-text-300;
  }
</style>
