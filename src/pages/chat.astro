    padding: 0.4rem 0.65rem;
    font-size: 0.875rem;
    color: rgb(var(--text-200));
  }
  .convo-title,
  .convo-sub {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .convo-sub {
    font-size: 0.7rem;
    color: rgb(var(--text-300));
  }
  .convo-list > li:has(.convo-item.is-active) {
    background: rgb(var(--hover) / 0.09);
  }
  .convo-item.is-active {
    color: rgb(var(--text-100));
  }
  .convo-more {
    width: 1.9rem;
    flex-shrink: 0;
    padding: 0.3rem 0;
    text-align: center;
    color: rgb(var(--text-300));
    opacity: 0;
    font-size: 1rem;
  }
  .convo-list > li:hover .convo-more,
  .convo-more:focus-visible {
    opacity: 1;
  }
  .convo-more:hover {
    color: rgb(var(--text-100));
  }
  @media (hover: none) {
    .convo-more {
      opacity: 0.7;
    }
  }
  .convo-nested {
    padding-left: 1.1rem;
  }
  .project-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
    padding: 0.4rem 0.65rem;
    font-size: 0.875rem;
    text-align: left;
    color: rgb(var(--text-100));
  }
  .section-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font: inherit;
    color: inherit;
  }
  .chevron {
    display: inline-block;
    width: 0.7rem;
    text-align: center;
    color: rgb(var(--text-300));
    transform: rotate(90deg);
    transition: transform 0.12s ease;
  }
  [aria-expanded='false'] > .chevron {
    transform: none;
  }
  .sources-rail {
    width: 20rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-left: 1px solid rgb(var(--border) / 0.6);
  }
  .sources-rail[hidden] {
    display: none;
  }
  .sources-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 0.75rem;
    flex-shrink: 0;
  }
  .sources-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    color: rgb(var(--text-100));
  }
  .sources-list {
    flex: 1;
    overflow-y: auto;
    padding: 0 1rem 1rem;
  }
  .panel-row {
    position: relative;
    border-bottom: 1px solid rgb(var(--border) / 0.6);
  }
  .panel-row:last-child {
    border-bottom: 0;
  }
  .panel-row-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 3rem;
    padding-right: 3.75rem;
    text-align: left;
    font-size: 0.875rem;
    color: rgb(var(--text-100));
  }
  .panel-row-head svg {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: rgb(var(--text-200));
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .panel-row-sub {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.75rem;
    color: rgb(var(--text-300));
  }
  .panel-row-action {
    position: absolute;
    top: 0.9rem;
    right: 0;
    font-size: 0.82rem;
    color: rgb(var(--text-100));
  }
  .panel-row-action:hover {
    color: rgb(var(--accent-1));
  }
  .panel-row-body {
    padding: 0 0 0.85rem;
  }
  .panel-text {
    white-space: pre-wrap;
    font-size: 0.82rem;
    color: rgb(var(--text-200));
  }
  .sources-label {
    margin: 0.75rem 0 0.35rem;
    font-size: 0.72rem;
    color: rgb(var(--text-300));
  }
  .source-row {
    display: block;
    width: 100%;
    padding: 0.3rem 0;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.82rem;
    color: rgb(var(--text-200));
  }
  button.source-row:hover {
    color: rgb(var(--accent-1));
  }
  .source-row.is-expired {
    text-decoration: line-through;
    color: rgb(var(--text-300));
  }
  .context-bar {
    height: 0.35rem;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(var(--border));
  }
  .context-bar span {
    display: block;
    height: 100%;
    background: rgb(var(--accent-1));
  }
  .context-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0;
    font-size: 0.82rem;
    color: rgb(var(--text-200));
  }
  .context-memory {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .project-toggle[aria-expanded='false'] {
    color: rgb(var(--text-200));
  }
  .section-add {
    padding: 0 0.4rem;
    font-size: 1rem;
    line-height: 1;
    color: rgb(var(--text-300));
  }
  .section-add:hover {
    color: rgb(var(--text-100));
  }
  .convo-menu {
    position: fixed;
    z-index: 50;
    min-width: 11rem;
    padding: 0.3rem;
    border-radius: 0.7rem;
    background: rgb(var(--bg-elev-2));
    border: 1px solid rgb(var(--border));
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
  }
  .convo-menu .menu-item--danger {
    color: rgb(var(--accent-2));
  }

  .sidebar-foot {
    padding: 0.35rem 0.5rem;
    border-top: 1px solid rgb(var(--border) / 0.6);
  }
  .account {
    position: relative;
    border-top: 1px solid rgb(var(--border) / 0.6);
    padding: 0.5rem;
  }
  .account-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.55rem;
    border-radius: 0.6rem;
    cursor: pointer;
    list-style: none;
  }
  .account-row::-webkit-details-marker {
    display: none;
  }
  .account-row:hover {
    background: rgb(var(--hover) / 0.06);
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgb(var(--text-100));
    color: rgb(var(--bg-base));
    font-size: 0.8rem;
    font-weight: 600;
  }
  .account-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .account-name {
    font-size: 0.88rem;
    color: rgb(var(--text-100));
  }
  .account-sub {
    font-size: 0.72rem;
    color: rgb(var(--text-300));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account-menu {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: calc(100% - 0.25rem);
    padding: 0.35rem;
    border-radius: 0.8rem;
    background: rgb(var(--bg-elev-2));
    border: 1px solid rgb(var(--border));
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.3);
  }
  .menu-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: rgb(var(--text-200));
  }
  .menu-item:hover {
    background: rgb(var(--hover) / 0.07);
    color: rgb(var(--text-100));
  }
  .menu-note {
    padding: 0.3rem 0.65rem 0.2rem;
    font-size: 0.7rem;
    color: rgb(var(--text-300));
  }

  /* Wide screens: sidebar sits beside the chat and can be tucked away. */
  @media (min-width: 900px) {
    .drawer-backdrop {
      display: none !important;
    }
    .sidebar {
      position: relative;
      width: var(--sidebar-width, 17.5rem);
    }
    .chat-body.sidebar-collapsed .sidebar {
      margin-left: calc(-1 * var(--sidebar-width, 17.5rem));
    }
    .topbar .topbar-menu,
    .topbar .topbar-new {
      display: none;
    }
    .chat-body.sidebar-collapsed .topbar .topbar-menu,
    .chat-body.sidebar-collapsed .topbar .topbar-new {
      display: inline-flex;
    }
  }
  @media (min-width: 1100px) {
    .sources-rail {
      position: relative;
      width: var(--project-panel-width, 20rem);
    }
    .sources-rail.is-closed {
      display: none;
    }
  }
  .resizer {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 5;
    width: 0.6rem;
    cursor: col-resize;
    touch-action: none;
  }
  .resizer--left {
    left: -0.3rem;
  }
  .resizer--right {
    right: -0.3rem;
  }
  .resizer:hover,
  .resizer:focus-visible,
  .is-resizing .resizer {
    background: linear-gradient(rgb(var(--accent-1) / 0.5), rgb(var(--accent-1) / 0.5)) center / 2px 100% no-repeat;
    outline: none;
  }
  @media (min-width: 900px) {
    .sidebar .resizer,
    .html-panel .resizer {
      display: block;
    }
  }
  @media (min-width: 1100px) {
    .sources-rail .resizer {
      display: block;
    }
  }
  .is-resizing {
    cursor: col-resize;
    user-select: none;
  }
  .is-resizing iframe {
    pointer-events: none;
  }
  /* The project panel slides in over the chat when there's no room for it. */
  @media (max-width: 1099px) {
    .sources-rail {
      position: fixed;
      inset: 0 0 0 auto;
      z-index: 40;
      width: min(85vw, 20rem);
      background: rgb(var(--bg-base));
      transform: translateX(100%);
    }
    .sources-rail.is-open {
      transform: translateX(0);
      box-shadow: 0 0 40px rgb(0 0 0 / 0.35);
    }
  }
  .chat-app:has(.html-panel.is-open) .sources-rail {
    display: none;
  }
  /* Phones and small windows: sidebar slides in over the chat. */
  @media (max-width: 899px) {
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      width: min(85vw, 19rem);
      transform: translateX(-100%);
    }
    .sidebar.is-open {
      transform: translateX(0);
      box-shadow: 0 0 40px rgb(0 0 0 / 0.35);
    }
    .project-label {
      display: none;
    }
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      z-index: 30;
      background: rgb(0 0 0 / 0.45);
    }
  }

  /* ─── HTML preview ───────────────────────────────────────────────── */
  .html-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: rgb(var(--bg-elev));
  }
  .html-panel-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 0.75rem;
    flex-shrink: 0;
  }
  .html-panel-title {
    flex: 1;
    min-width: 0;
    font-size: 0.9rem;
    color: rgb(var(--text-100));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .split-view {
    display: none;
    flex: 1;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 0;
    overflow-y: auto;
    padding: 1rem;
    background: rgb(var(--bg-base));
  }
  .html-panel.is-split .split-view {
    display: flex;
  }
  .file-view {
    display: none;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 0;
    overflow-y: auto;
    padding: 0.75rem;
    background: rgb(var(--bg-base));
  }
  .html-panel.is-file .file-view {
    display: flex;
  }
  .html-panel.is-file .html-panel-frame {
    display: none;
  }
  .pdf-page,
  .file-image {
    display: block;
    width: 100%;
    flex-shrink: 0;
    border-radius: 0.25rem;
    background: white;
  }
  .file-image {
    height: auto;
    background: none;
  }
  .file-text {
    white-space: pre-wrap;
    font-size: 0.85rem;
    color: rgb(var(--text-100));
  }
  .apps-page {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }
  .apps-page[hidden],
  .chat-main.is-apps .scroller,
  .chat-main.is-apps .hero,
  .chat-main.is-apps .composer-wrap,
  .chat-main.is-apps .topbar-title,
  .chat-main.is-apps .project-label,
  .chat-main.is-apps .topbar .sources-btn,
  .chat-app:has(.is-apps) .sources-rail {
    display: none;
  }
  .apps-inner {
    max-width: 70rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 3rem;
  }
  .apps-title {
    margin-bottom: 1.25rem;
    font-family: ui-serif, Georgia, 'Times New Roman', serif !important;
    font-weight: 400;
    font-size: 1.9rem;
    color: rgb(var(--text-100));
  }
  .apps-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .apps-filters {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 0.25rem;
    min-width: 0;
  }
  @media (max-width: 699px) {
    .apps-filters {
      flex: 1 1 100%;
    }
    .apps-tools input,
    .apps-tools select {
      flex: 1;
      width: auto;
    }
  }
  .apps-filter {
    white-space: nowrap;
    padding: 0.3rem 0.7rem;
    border-radius: 0.6rem;
    font-size: 0.875rem;
    color: rgb(var(--text-200));
  }
  .apps-filter[aria-pressed='true'] {
    color: rgb(var(--text-100));
    background: rgb(var(--hover) / 0.12);
  }
  .apps-tools input,
  .apps-tools select {
    min-width: 0;
    width: 10rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.6rem;
    font-size: 0.82rem;
    color: rgb(var(--text-100));
    background: rgb(var(--bg-elev));
    border: 1px solid rgb(var(--border));
  }
  .apps-label {
    margin: 1.5rem 0 0.6rem;
    font-size: 0.85rem;
    color: rgb(var(--text-300));
  }
  .apps-starters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.9rem;
    margin-bottom: 2rem;
  }
  .app-starter {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
    font-size: 0.875rem;
    color: rgb(var(--text-100));
  }
  .app-starter-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5.5rem;
    border-radius: 0.8rem;
    background: rgb(var(--tile));
    transition: filter 0.15s ease;
  }
  .app-starter:hover .app-starter-tile {
    filter: brightness(1.2);
  }
  .app-starter svg {
    width: 2.4rem;
    height: 2.4rem;
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.1rem;
  }
  .app-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 0.9rem;
    background: rgb(var(--bg-elev));
    border: 1px solid rgb(var(--border));
    transition: border-color 0.15s ease;
  }
  .app-card:hover {
    border-color: rgb(var(--text-300));
  }
  .app-open {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    text-align: left;
    color: rgb(var(--text-100));
  }
  .app-thumb {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgb(var(--hover) / 0.08);
  }
  .app-thumb iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1200px;
    height: 675px;
    border: 0;
    background: white;
    pointer-events: none;
    transform: scale(var(--thumb-scale, 0.25));
    transform-origin: top left;
  }
  .app-foot {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.7rem 2.4rem 0.75rem 0.85rem;
    min-width: 0;
  }
  .app-more {
    position: absolute;
    right: 0.4rem;
    bottom: 0.7rem;
    opacity: 1;
  }
  .apps-grid.is-list {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }
  .apps-grid.is-list .app-thumb {
    display: none;
  }
  .composer-wrap {
    position: relative;
  }
  .chip-btn.model-chip,
  .to-bottom {
    display: none;
  }
  @media (max-width: 899px) {
    .composer-inner .composer-under,
    #web-btn span,
    .topbar #project-edit-btn {
      display: none;
    }
    .topbar .composer-project {
      flex: 0 1 auto;
      min-width: 0;
      max-width: 9rem;
      padding: 0;
      font-size: 0.8rem;
    }
    .topbar .composer-project .text-select {
      max-width: 100%;
      min-width: 0;
    }
    .chat-main.is-apps .topbar .composer-project {
      display: none;
    }
    #web-btn {
      flex-shrink: 0;
      padding-inline: 0.5rem;
    }
    .chip-btn.model-chip {
      display: inline-flex;
      min-width: 0;
      max-width: 11rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.78rem;
    }
    .composer-tools {
      min-width: 0;
    }
    .to-bottom:not([hidden]) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: -3rem;
      left: 50%;
      z-index: 5;
      width: 2.5rem;
      height: 2.5rem;
      margin-left: -1.25rem;
      border-radius: 999px;
      color: rgb(var(--text-100));
      background: rgb(var(--bg-elev-2));
      border: 1px solid rgb(var(--border));
      box-shadow: 0 6px 18px rgb(0 0 0 / 0.3);
    }
    .chat-main.is-empty .to-bottom {
      display: none;
    }
    .settings-dialog.model-sheet {
      width: 100%;
      max-width: 100%;
      max-height: 80dvh;
      margin: auto 0 0;
      padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
      border-radius: 1rem 1rem 0 0;
      border-width: 1px 0 0;
    }
  }
  .sheet-option {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0.65rem 0.75rem;
    border-radius: 0.6rem;
    text-align: left;
    font-size: 0.92rem;
    color: rgb(var(--text-100));
  }
  .sheet-option small {
    font-size: 0.75rem;
    color: rgb(var(--text-300));
  }
  .sheet-option[aria-pressed='true'] {
    background: rgb(var(--hover) / 0.12);
  }
  .page-btn {
    display: inline-flex;
    margin: 0.25rem 0;
  }
  .topbar .sources-btn[hidden] {
    display: none;
  }
  .file-link {
    font: inherit;
    color: rgb(var(--accent-1));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .out-image {
    cursor: zoom-in;
  }
  .att-open {
    display: block;
    border-radius: 0.6rem;
  }
  .html-panel.is-split .html-panel-frame,
  .html-panel.is-split #html-panel-save {
    display: none;
  }
  .html-panel-frame {
    flex: 1;
    width: 100%;
    border: 0;
    background: #fff;
  }
  @media (min-width: 900px) {
    .html-panel {
      position: relative;
      display: none;
      flex: 0 0 var(--html-panel-width, 50%);
      border-left: 1px solid rgb(var(--border) / 0.6);
    }
    .html-panel.is-open {
      display: flex;
    }
  }
  @media (max-width: 899px) {
    .html-panel {
      position: fixed;
      inset: 0;
      z-index: 40;
      padding-top: env(safe-area-inset-top);
      visibility: hidden;
      transform: translateX(100%);
      transition: transform 0.25s ease, visibility 0.25s;
    }
    .html-panel.is-open {
      visibility: visible;
      transform: none;
    }
  }

  /* ─── Composer ───────────────────────────────────────────────────── */
  .composer-wrap {
    flex-shrink: 0;
    padding: 0 1rem calc(0.75rem + env(safe-area-inset-bottom));
  }
  .composer-inner {
    max-width: 46rem;
    margin: 0 auto;
  }
  .composer-project {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.35rem 0.4rem;
    font-size: 0.85rem;
  }
  .composer-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 0.75rem 0.6rem 1rem;
    border-radius: 1.25rem;
    background: rgb(var(--bg-elev-2));
    border: 1px solid rgb(var(--border));
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.12);
    transition: border-color 0.15s;
  }
  .composer-card:focus-within {
    border-color: rgb(var(--text-300) / 0.7);
  }
  .composer-card textarea {
    width: 100%;
    max-height: 14rem;
    resize: none;
    background: transparent;
    border: 0;
    outline: none;
    font-size: 16px; /* 16px+ keeps iOS Safari from zooming in */
    line-height: 1.5;
    color: rgb(var(--text-100));
  }
  .composer-card textarea::placeholder {
    color: rgb(var(--text-300));
  }
  .chat-main.is-empty .composer-card textarea {
    min-height: 3.2rem;
  }
  .composer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .composer-tools,
  .composer-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }
  .tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border-radius: 0.6rem;
    border: 1px solid rgb(var(--border));
    color: rgb(var(--text-200));
  }
  .tool-btn:hover {
    background: rgb(var(--hover) / 0.06);
    color: rgb(var(--text-100));
  }
  .tool-btn[hidden] {
    display: none;
  }
  #mic-btn {
    border-color: transparent;
  }
  #mic-btn[aria-pressed='true'] {
    background: rgb(var(--accent-2));
    color: #fff;
    animation: typing 1.2s ease-in-out infinite;
  }
  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.1rem;
    padding: 0 0.7rem;
    border-radius: 0.6rem;
    border: 1px solid rgb(var(--border));
    font-size: 0.82rem;
    color: rgb(var(--text-300));
    white-space: nowrap;
  }
  .chip-btn:hover {
    color: rgb(var(--text-100));
  }
  .chip-btn[aria-pressed='true'] {
    color: rgb(var(--accent-1));
    border-color: rgb(var(--accent-1) / 0.55);
    background: rgb(var(--accent-1) / 0.1);
  }
  .send-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border-radius: 0.6rem;
    background: rgb(var(--accent-1));
    color: #fff;
    transition: opacity 0.15s, transform 0.15s;
  }
  .send-btn:hover {
    opacity: 0.9;
  }
  .send-btn:active {
    transform: scale(0.95);
  }
  .send-btn[hidden] {
    display: none;
  }
  .send-btn--stop {
    background: rgb(var(--text-100));
    color: rgb(var(--bg-base));
  }
  .composer-under {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.35rem 0;
    font-size: 0.85rem;
  }
  .under-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }
  .under-right {
    margin-left: auto;
  }
  .meter {
    min-width: 0;
    font-size: 0.72rem;
    color: rgb(var(--text-300));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 640px) {
    .composer-under {
      flex-wrap: wrap;
    }
    .meter {
      order: 3;
      width: 100%;
    }
  }
  /* Selects that read like text: "Proje ▾", "Opus 5.5 ▾", "Orta ▾". */
  .text-select {
    position: relative;
    display: inline-flex;
    border-radius: 0.5rem;
  }
  .text-select:hover {
    background: rgb(var(--hover) / 0.06);
  }
  .text-select select {
    appearance: none;
    max-width: 11rem;
    padding: 0.3rem 1.3rem 0.3rem 0.5rem;
    background: transparent;
    border: 0;
    outline: none;
    font-size: 0.85rem;
    color: rgb(var(--text-300));
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .text-select--strong select {
    color: rgb(var(--text-100));
  }
  .text-select select option {
    color: rgb(var(--text-100));
    background: rgb(var(--bg-elev-2));
  }
  .text-select::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 0.32rem;
    height: 0.32rem;
    border-right: 1.5px solid rgb(var(--text-300));
    border-bottom: 1.5px solid rgb(var(--text-300));
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .link-btn {
    font-size: 0.8rem;
    color: rgb(var(--text-300));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .link-btn[hidden] {
    display: none;
  }

  /* ─── Attachments tray ───────────────────────────────────────────── */
  .attach-tray {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 0.25rem 0.5rem;
  }
  .attach-tray[hidden] {
    display: none;
  }
  .tray-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 100%;
    padding: 0.3rem 0.3rem 0.3rem 0.4rem;
    border-radius: 0.7rem;
    font-size: 0.8rem;
    color: rgb(var(--text-200));
    background: rgb(var(--bg-elev-2));
    border: 1px solid rgb(var(--border));
  }
  .tray-chip.is-error {
    border-color: rgb(var(--accent-2));
  }
  .tray-chip img {
    width: 2rem;
    height: 2rem;
    border-radius: 0.4rem;
    object-fit: cover;
  }
  .tray-name {
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tray-state {
    color: rgb(var(--text-300));
    font-size: 0.75rem;
  }
  .tray-chip.is-error .tray-state {
    color: rgb(var(--accent-2));
  }
  .tray-del {
    padding: 0 0.4rem;
    font-size: 1rem;
    color: rgb(var(--text-300));
  }
  .tray-del:hover {
    color: rgb(var(--accent-2));
  }
  body.is-dragging .composer-card {
    border-color: rgb(var(--accent-1));
    border-style: dashed;
  }

  /* ─── Messages ───────────────────────────────────────────────────── */
  .msg-user {
    max-width: 85%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 0.65rem 1rem;
    border-radius: 1.1rem;
    background: rgb(var(--bg-elev-2));
    color: rgb(var(--text-100));
    line-height: 1.55;
  }
  html[data-theme='light'] .msg-user {
    background: rgb(var(--bg-elev));
  }
  .msg-assistant {
    overflow-wrap: anywhere;
    line-height: 1.7;
    color: rgb(var(--text-100));
  }
  .msg-actions {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.35rem;
    opacity: 0.75;
  }
  .msg-actions {
    align-items: center;
  }
  .msg-time {
    padding: 0.2rem 0.25rem;
    font-size: 0.72rem;
    color: rgb(var(--text-300));
  }
  .msg-action {
    padding: 0.2rem 0.5rem;
    border-radius: 0.45rem;
    font-size: 0.75rem;
    color: rgb(var(--text-300));
  }
  .msg-action:hover {
    background: rgb(var(--hover) / 0.07);
    color: rgb(var(--text-100));
  }
  .msg-meta {
    margin-top: 0.4rem;
    font-size: 0.7rem;
    color: rgb(var(--text-300));
  }
  .msg-meta[hidden] {
    display: none;
  }
  .msg-atts {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }
  .msg-atts:last-child {
    margin-bottom: 0;
  }
  .msg-thumb {
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    border-radius: 0.7rem;
  }
  .att-chip {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.3rem 0.6rem;
    border-radius: 0.6rem;
    font-size: 0.78rem;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--bg-base));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .is-expired {
    opacity: 0.45;
  }
  .out-files {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .out-image {
    max-width: 100%;
    max-height: 24rem;
    border-radius: 0.7rem;
    border: 1px solid rgb(var(--border));
    background: #fff;
  }
  .out-chip {
    cursor: pointer;
    color: rgb(var(--accent-1));
    border-color: rgb(var(--accent-1) / 0.45);
  }
  .out-chip:hover {
    background: rgb(var(--accent-1) / 0.1);
  }
  .chat-note {
    font-size: 0.8rem;
    margin-top: 0.6rem;
  }
  .thinking {
    margin-bottom: 0.75rem;
  }
  .thinking summary,
  .summary-divider summary {
    cursor: pointer;
    width: fit-content;
    padding: 0.2rem 0.55rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    color: rgb(var(--text-300));
  }
  .thinking summary:hover,
  .summary-divider summary:hover {
    background: rgb(var(--hover) / 0.06);
    color: rgb(var(--text-100));
  }
  .thinking-body {
    margin-top: 0.4rem;
    padding: 0.2rem 0 0.2rem 0.85rem;
    border-left: 2px solid rgb(var(--border));
    white-space: pre-wrap;
    font-size: 0.85rem;
    color: rgb(var(--text-300));
  }
  .tool-status {
    margin-bottom: 0.6rem;
    font-size: 0.8rem;
    color: rgb(var(--text-300));
  }
  .sources {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.9rem;
    font-size: 0.82rem;
  }
  .sources-label {
    font-size: 0.75rem;
    color: rgb(var(--text-300));
  }
  .sources a {
    color: rgb(var(--accent-1));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sources a:hover {
    text-decoration: underline;
  }
  .thinking[hidden],
  .tool-status[hidden],
  .sources[hidden] {
    display: none;
  }
  .summary-divider {
    padding: 0.4rem 0;
    border-top: 1px dashed rgb(var(--border));
    border-bottom: 1px dashed rgb(var(--border));
  }

  /* Markdown */
  .chat-md > * + * {
    margin-top: 0.85em;
  }
  .chat-md p {
    color: rgb(var(--text-100));
  }
  .chat-md h1,
  .chat-md h2,
  .chat-md h3 {
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
    margin-top: 1.4em;
    margin-bottom: 0;
    color: rgb(var(--text-100));
  }
  .chat-md ul,
  .chat-md ol {
    list-style-position: outside;
    padding-left: 1.4em;
    color: rgb(var(--text-100));
  }
  .chat-md li > p {
    display: inline;
  }
  .chat-md li + li {
    margin-top: 0.3em;
  }
  .chat-md a {
    color: rgb(var(--accent-1));
  }
  .chat-md code {
    border-radius: 0.35rem;
    color: rgb(var(--text-100));
    background: rgb(var(--hover) / 0.08);
    border: 0;
  }
  .chat-md pre {
    position: relative;
    font-size: 0.85rem;
    line-height: 1.55;
    border-radius: 0.8rem;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--bg-elev));
  }
  .chat-md pre code {
    background: transparent;
  }
  .chat-md blockquote {
    border-left-color: rgb(var(--border));
    font-style: normal;
  }
  .chat-md table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .chat-md th,
  .chat-md td {
    border: 1px solid rgb(var(--border));
    padding: 0.35rem 0.6rem;
    text-align: left;
  }
  .chat-md hr {
    border-color: rgb(var(--border));
  }
  .copy-btn.preview-btn {
    right: 5rem;
    opacity: 1;
    color: rgb(var(--text-100));
  }
  .copy-btn {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    padding: 0.15rem 0.55rem;
    border-radius: 0.4rem;
    font-size: 0.72rem;
    color: rgb(var(--text-300));
    background: rgb(var(--bg-elev-2));
    border: 1px solid rgb(var(--border));
  }
  .copy-btn:hover {
    color: rgb(var(--text-100));
  }

  /* Code highlighting (highlight.js classes). */
  .chat-md .hljs-keyword,
  .chat-md .hljs-selector-tag,
  .chat-md .hljs-meta .hljs-keyword {
    color: #c678dd;
  }
  .chat-md .hljs-string,
  .chat-md .hljs-attr,
  .chat-md .hljs-template-tag,
  .chat-md .hljs-addition {
    color: #98c379;
  }
  .chat-md .hljs-number,
  .chat-md .hljs-literal {
    color: #d19a66;
  }
  .chat-md .hljs-title,
  .chat-md .hljs-title.function_,
  .chat-md .hljs-built_in,
  .chat-md .hljs-type {
    color: #61afef;
  }
  .chat-md .hljs-comment,
  .chat-md .hljs-quote,
  .chat-md .hljs-deletion {
    color: rgb(var(--text-300));
    font-style: italic;
  }
  html[data-theme='light'] .chat-md .hljs-keyword { color: #a626a4; }
  html[data-theme='light'] .chat-md .hljs-string,
  html[data-theme='light'] .chat-md .hljs-attr { color: #50a14f; }
  html[data-theme='light'] .chat-md .hljs-number,
  html[data-theme='light'] .chat-md .hljs-literal { color: #986801; }
  html[data-theme='light'] .chat-md .hljs-title,
  html[data-theme='light'] .chat-md .hljs-built_in,
  html[data-theme='light'] .chat-md .hljs-type { color: #4078f2; }

  /* Math (MathML drawn by the browser). */
  .chat-md math {
    font-size: 1.08em;
  }
  .chat-md math[display='block'] {
    display: block;
    margin: 0.75em 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  /* The TeX source KaTeX keeps for copy/paste; browsers hide it already. */
  .chat-md annotation {
    display: none;
  }

  .typing {
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.4rem 0;
  }
  .typing i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(var(--accent-1));
    animation: typing 1s ease-in-out infinite;
  }
  .typing i:nth-child(2) { animation-delay: 0.15s; }
  .typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typing {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }
  .thinking-label {
    margin-left: 0.6rem;
    font-size: 0.8rem;
    color: rgb(var(--text-300));
  }

  /* ─── Buttons, dialogs, gate ─────────────────────────────────────── */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.6rem;
    color: rgb(var(--text-300));
  }
  .icon-btn:hover {
    background: rgb(var(--hover) / 0.07);
    color: rgb(var(--text-100));
  }
  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: 0.6rem;
    font-size: 0.875rem;
    border: 1px solid rgb(var(--border));
    color: rgb(var(--text-200));
    transition: background 0.15s;
  }
  .ask-dialog {
    width: min(26rem, calc(100vw - 2rem));
  }
  .ask-dialog p {
    padding-right: 2rem;
  }
  .ask-dialog input[hidden] {
    display: none;
  }
  .ask-dialog input:not([hidden]) {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 0.6rem;
    color: rgb(var(--text-100));
  }
  .pill-btn.ask-ok {
    color: rgb(255 255 255);
    background: rgb(var(--accent-1));
    border-color: transparent;
  }
  .pill-btn.ask-ok.is-danger {
    background: rgb(var(--accent-2));
  }
  .pill-btn.ask-ok:hover {
    color: rgb(255 255 255);
    filter: brightness(1.1);
    background: rgb(var(--accent-1));
  }
  .pill-btn.ask-ok.is-danger:hover {
    background: rgb(var(--accent-2));
  }
  .pill-btn:hover {
    background: rgb(var(--hover) / 0.06);
    color: rgb(var(--text-100));
  }
  .pill-btn--primary {
    border-color: rgb(var(--accent-1));
    background: rgb(var(--accent-1));
    color: #fff;
  }
  .pill-btn--primary:hover {
    background: rgb(var(--accent-1) / 0.9);
    color: #fff;
  }
  .pill-btn:disabled {
    opacity: 0.6;
  }
  .pill-btn[hidden] {
    display: none;
  }
  .settings-dialog {
    width: min(34rem, calc(100vw - 2rem));
    padding: 1.4rem;
    border-radius: 1rem;
    color: rgb(var(--text-200));
    background: rgb(var(--bg-elev-2));
    border: 1px solid rgb(var(--border));
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
  }
  .settings-dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }
  .settings-dialog .font-mono {
    font-family: inherit;
    text-transform: none;
    letter-spacing: normal;
    font-size: 1rem;
    color: rgb(var(--text-100));
  }
  .settings-dialog input:not([type='checkbox']),
  .settings-dialog textarea,
  #gate-input {
    border-radius: 0.6rem;
    font-size: 16px;
  }
  .memory-list {
    max-height: 55vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .memory-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgb(var(--text-100));
  }
  .memory-body {
    margin-top: 0.3rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
    white-space: pre-wrap;
    font-size: 0.82rem;
    color: rgb(var(--text-200));
    background: rgb(var(--bg-base));
    border: 1px solid rgb(var(--border));
  }
  #gate-form {
    border-radius: 1rem;
  }
  #gate-form .font-mono {
    font-family: inherit;
    text-transform: none;
    letter-spacing: normal;
  }
  #gate-form h1 {
    font-family: ui-serif, Georgia, serif;
    font-size: 1.6rem;
  }

  /* ─── Settings ───────────────────────────────────────────────────── */
  .settings-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-height: calc(100dvh - 4rem);
  }
  .dialog-x {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
  .overlay-x {
    display: none;
  }
  @media (max-width: 899px) {
    .overlay-x {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      z-index: 45;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 999px;
      color: rgb(var(--text-100));
      background: rgb(var(--bg-elev-2));
      border: 1px solid rgb(var(--border));
      box-shadow: 0 6px 18px rgb(0 0 0 / 0.3);
    }
    .sources-rail .overlay-x,
    .html-panel .overlay-x,
    .sidebar .overlay-x {
      position: absolute;
    }
    .sidebar .overlay-x--drawer {
      bottom: 4.5rem;
      right: 0.75rem;
    }
  }
  .emoji-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .emoji-btn {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    font-size: 1.1rem;
  }
  .emoji-btn:hover {
    background: rgb(var(--hover) / 0.07);
  }
  .emoji-btn[aria-checked='true'] {
    border-color: rgb(var(--accent-1));
    background: rgb(var(--hover) / 0.07);
  }
  .settings-title {
    margin: 0;
    font-family: ui-serif, Georgia, serif !important;
    font-size: 1.4rem;
    font-weight: 400;
    color: rgb(var(--text-100));
  }
  .settings-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--border));
  }
  .settings-section h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgb(var(--text-100));
  }
  .settings-section h3 small,
  .field small,
  .switch-row small {
    font-weight: 400;
    font-size: 0.75rem;
    color: rgb(var(--text-300));
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.55rem 0.75rem;
    color: rgb(var(--text-100));
    background: rgb(var(--bg-base));
    border: 1px solid rgb(var(--border));
    outline: none;
    line-height: 1.5;
  }
