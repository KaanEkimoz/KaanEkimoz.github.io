---
/**
 * /chat — private, password-protected Claude chat.
 *
 * Standalone page (no BaseLayout): no header/footer, no
 * hreflang/canonical, noindex, and left out of the sitemap in
 * astro.config.mjs. Not linked from anywhere on the site.
 *
 * Requests go to the Cloudflare Worker in worker/ (URL in
 * CHAT_WORKER_URL), which holds the Anthropic key, checks each person's
 * password and keeps their history in D1. Nothing secret lives in this
 * file. localStorage is only a cache of the server history, kept per user.
 */
import '../styles/global.css';
import { CHAT_EFFORTS, CHAT_MODELS } from '@lib/constants';
---

<!doctype html>
<html lang="tr-TR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0a0a14" />
    <title>Sohbet</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Installable app, scoped to /chat/ only (see public/chat/). */}
    <link rel="manifest" href="/chat/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/chat/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Sohbet" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    {/* Same pre-paint theme setter as BaseLayout, so /chat follows the
        visitor's saved dark/light choice without a flash. */}
    <script is:inline>
      (function () {
        try {
          var stored = null;
          try { stored = localStorage.getItem('fx-theme'); } catch (e) {}
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
                  ? 'light'
                  : 'dark');
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f5f4ef' : '#0a0a14');
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="chat-body">
    <div class="chat-app">
      <!-- Sidebar: always there on wide screens (collapsible), a drawer on phones -->
      <div id="drawer-backdrop" class="drawer-backdrop hidden"></div>
      <aside id="drawer" class="sidebar" aria-label="Sohbetler">
        <div class="sidebar-top">
          <span class="brand"><span class="brand-mark">◆</span> Sohbet</span>
          <button id="drawer-close" type="button" class="icon-btn" aria-label="Kenar çubuğunu kapat" title="Kenar çubuğunu kapat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /></svg>
          </button>
        </div>

        <nav class="sidebar-nav">
          <button id="new-btn" type="button" class="nav-item nav-item--primary" data-new-chat>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            <span>Yeni sohbet</span>
          </button>
          <label class="nav-item nav-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <span class="sr-only">Sohbetlerde ara</span>
            <input id="convo-search" type="search" placeholder="Ara" autocomplete="off" />
          </label>
          <button id="memory-btn" type="button" class="nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3a6 6 0 0 0-6 6c0 2.2 1.2 3.6 2 4.5.6.7 1 1.5 1 2.5h6c0-1 .4-1.8 1-2.5.8-.9 2-2.3 2-4.5a6 6 0 0 0-6-6zM9.5 19h5M10.5 22h3" /></svg>
            <span>Hafıza</span>
          </button>
        </nav>

        <div class="sidebar-section">Son sohbetler</div>
        <ul id="convo-list" class="convo-list"></ul>

        <div class="sidebar-foot">
          <button id="settings-btn" type="button" class="nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>
            <span>Ayarlar</span>
          </button>
        </div>

        <details class="account">
          <summary class="account-row">
            <span id="user-avatar" class="avatar">?</span>
            <span class="account-text">
              <span id="user-name" class="account-name">Hesap</span>
              <span id="usage-line" class="account-sub"></span>
            </span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
          </summary>
          <div class="account-menu">
            <button id="export-btn" type="button" class="menu-item">Bu sohbeti indir (.md)</button>
            <button id="clear-btn" type="button" class="menu-item">Tüm geçmişi sil</button>
            <button id="logout-btn" type="button" class="menu-item">Çıkış yap</button>
            <p id="sync-status" class="menu-note"></p>
          </div>
        </details>
      </aside>

      <!-- Conversation -->
      <section id="chat-main" class="chat-main is-empty">
        <header class="topbar">
          <button id="history-btn" type="button" class="icon-btn topbar-menu" aria-label="Kenar çubuğunu aç" aria-expanded="false" aria-controls="drawer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /></svg>
          </button>
          <span id="chat-title" class="topbar-title"></span>
          <span id="project-label" class="project-label" hidden></span>
          <button type="button" class="icon-btn topbar-new" aria-label="Yeni sohbet" title="Yeni sohbet" data-new-chat>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
          </button>
        </header>

        <main id="scroller" class="scroller">
          <div id="messages" class="messages" aria-live="polite"></div>
        </main>

        <div id="empty" class="hero">
          <h1 class="greeting"><span class="greeting-mark" aria-hidden="true">◆</span> <span id="greeting">Merhaba</span></h1>
        </div>

        <footer class="composer-wrap">
          <div class="composer-inner">
            <div class="composer-project">
              <label class="text-select">
                <span class="sr-only">Proje</span>
                <select id="project-select"></select>
              </label>
              <button id="project-edit-btn" type="button" class="link-btn" hidden>Düzenle</button>
            </div>
            <div id="attach-tray" class="attach-tray" hidden></div>
            <form id="composer" class="composer-card">
              <label for="input" class="sr-only">Mesaj</label>
              <textarea id="input" rows="1" placeholder="Bugün sana nasıl yardımcı olabilirim?" autocomplete="off"></textarea>
              <div class="composer-bar">
                <div class="composer-tools">
                  <button id="attach-btn" type="button" class="tool-btn" aria-label="Dosya ekle" title="Dosya ekle: görsel, PDF, metin, Excel, Word">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                  </button>
                  <input
                    id="file-input"
                    type="file"
                    multiple
                    accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,.txt,.md,.csv,.json,.xlsx,.xls,.docx,.pptx"
                    hidden
                  />
                  <button id="web-btn" type="button" class="chip-btn" aria-pressed="false" title="Web'de arasın (arama başına ücretli). Paylaştığın bağlantıları bu düğme kapalıyken de okur.">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
                    <span>Web</span>
                  </button>
                  <button id="code-btn" type="button" class="chip-btn" aria-pressed="false" title="Kod çalıştırsın, dosya üretsin (Excel, Word, PDF, grafik)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>
                    <span>Kod</span>
                  </button>
                </div>
                <div class="composer-actions">
                  <button id="mic-btn" type="button" class="tool-btn" aria-label="Sesle yaz" aria-pressed="false" title="Sesle yaz" hidden>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
                  </button>
                  <button id="send-btn" type="submit" class="send-btn" aria-label="Gönder">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
                  </button>
                  <button id="stop-btn" type="button" class="send-btn send-btn--stop" aria-label="Durdur" hidden>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
                  </button>
                </div>
              </div>
            </form>
            <div class="composer-under">
              <span id="meter" class="meter" title="Bağlam: modelin bu sohbette okuduğu toplam token. Ücret tahminidir."></span>
              <div class="under-right">
                <label class="text-select text-select--strong">
                  <span class="sr-only">Model</span>
                  <select id="model-select">
                    {CHAT_MODELS.map((m) => <option value={m.id} title={m.hint}>{m.label}</option>)}
                  </select>
                </label>
                <label class="text-select">
                  <span class="sr-only">Güç</span>
                  <select id="effort-select">
                    {CHAT_EFFORTS.map((e) => <option value={e.id}>{e.label}</option>)}
                  </select>
                </label>
              </div>
            </div>
          </div>
        </footer>
      </section>
    </div>

    <!-- Settings: account-wide (saved on the server) and this device's own -->
    <dialog id="settings-dialog" class="settings-dialog">
      <form id="settings-form" method="dialog" class="settings-form">
        <h2 class="settings-title">Ayarlar</h2>

        <section class="settings-section">
          <h3>Profil</h3>
          <label class="field">
            <span>Adın</span>
            <input id="settings-name" maxlength="40" autocomplete="given-name" placeholder="Claude sana nasıl hitap etsin?" />
          </label>
          <label class="field">
            <span>Kişisel talimatlar</span>
            <textarea id="settings-input" rows="4" maxlength="2000"></textarea>
            <small>Claude her sohbette dikkate alır. Örneğin: "Kısa ve net yanıt ver", "Yemek tariflerinde gram kullan".</small>
          </label>
          <label class="switch-row">
            <span>
              <span class="switch-label">Hafıza</span>
              <small>Claude seninle ilgili önemli şeyleri not alır, sonraki sohbetlerde hatırlar. Notları menüdeki "Hafıza"dan görüp silebilirsin.</small>
            </span>
            <input id="settings-memory" type="checkbox" class="switch" />
          </label>
        </section>

        <section class="settings-section">
          <h3>Görünüm <small>bu cihaz</small></h3>
          <div class="field-row">
            <span>Tema</span>
            <div class="seg" role="radiogroup" aria-label="Tema">
              <label><input type="radio" name="theme" value="system" /><span>Sistem</span></label>
              <label><input type="radio" name="theme" value="light" /><span>Açık</span></label>
              <label><input type="radio" name="theme" value="dark" /><span>Koyu</span></label>
            </div>
          </div>
          <div class="field-row">
            <span>Yazı boyutu</span>
            <div class="seg" role="radiogroup" aria-label="Yazı boyutu">
              <label><input type="radio" name="font" value="s" /><span>Küçük</span></label>
              <label><input type="radio" name="font" value="m" /><span>Normal</span></label>
              <label><input type="radio" name="font" value="l" /><span>Büyük</span></label>
            </div>
          </div>
        </section>

        <section class="settings-section">
          <h3>Sohbet <small>bu cihaz</small></h3>
          <div class="field-row">
            <span>Enter tuşu</span>
            <div class="seg" role="radiogroup" aria-label="Enter tuşu">
              <label><input type="radio" name="enter" value="send" /><span>Gönder</span></label>
              <label><input type="radio" name="enter" value="newline" /><span>Yeni satır</span></label>
            </div>
          </div>
          <label class="switch-row">
            <span class="switch-label">Düşünce özetini göster</span>
            <input id="pref-thinking" type="checkbox" class="switch" />
          </label>
          <label class="switch-row">
            <span class="switch-label">Token ve maliyet bilgisini göster</span>
            <input id="pref-cost" type="checkbox" class="switch" />
          </label>
        </section>

        <p id="settings-error" class="text-sm text-accent-2 hidden" role="alert"></p>
        <div class="settings-actions">
          <button id="settings-cancel" type="button" class="pill-btn">Kapat</button>
          <button id="settings-save" type="submit" class="pill-btn pill-btn--primary">Kaydet</button>
        </div>
      </form>
    </dialog>

    <!-- Memory viewer -->
    <dialog id="memory-dialog" class="settings-dialog">
      <div class="space-y-4">
        <div>
          <div class="font-mono uppercase tracking-widest text-xs text-text-300 mb-2">Hafıza</div>
          <p class="text-sm text-text-200">Claude'un senin hakkında tuttuğu notlar. İstemediğini silebilirsin.</p>
        </div>
        <div id="memory-list" class="memory-list"></div>
        <div class="flex justify-end">
          <button id="memory-close" type="button" class="pill-btn">Kapat</button>
        </div>
      </div>
    </dialog>

    <!-- Project editor -->
    <dialog id="project-dialog" class="settings-dialog">
      <form id="project-form" method="dialog" class="space-y-4">
        <div class="font-mono uppercase tracking-widest text-xs text-text-300">Proje</div>
        <label class="block space-y-1">
          <span class="text-sm text-text-200">Ad</span>
          <input id="project-name" maxlength="80" required class="w-full bg-bg-base border border-border focus:border-accent-1 outline-none px-3 py-2 text-text-100" />
        </label>
        <label class="block space-y-1">
          <span class="text-sm text-text-200">Talimatlar (bu projedeki her sohbette geçerli)</span>
          <textarea id="project-instructions" rows="4" maxlength="4000" class="w-full bg-bg-base border border-border focus:border-accent-1 outline-none px-3 py-2 text-text-100 leading-relaxed"></textarea>
        </label>
        <div class="space-y-2">
          <span class="text-sm text-text-200">Dosyalar (her sohbetin başına eklenir, en fazla 10)</span>
          <div id="project-files" class="flex flex-wrap gap-2"></div>
          <button id="project-add-file" type="button" class="pill-btn">Dosya ekle</button>
          <input id="project-file-input" type="file" multiple hidden accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,.txt,.md,.csv,.json,.xlsx,.xls,.docx,.pptx" />
        </div>
        <p id="project-error" class="text-sm text-accent-2 hidden" role="alert"></p>
        <div class="flex justify-between gap-2">
          <button id="project-delete" type="button" class="pill-btn">Projeyi sil</button>
          <div class="flex gap-2">
            <button id="project-cancel" type="button" class="pill-btn">Vazgeç</button>
            <button id="project-save" type="submit" class="pill-btn pill-btn--primary">Kaydet</button>
          </div>
        </div>
      </form>
    </dialog>

    <!-- Password gate -->
    <div id="gate" class="fixed inset-0 z-50 bg-bg-base flex items-center justify-center px-6 hidden">
      <form id="gate-form" class="w-full max-w-sm border border-border bg-bg-elev p-6 space-y-4">
        <div>
          <div class="font-mono uppercase tracking-widest text-xs text-text-300 mb-2">Özel alan</div>
          <h1 class="font-mono text-xl text-text-100">Parolayı gir</h1>
        </div>
        <label for="gate-input" class="sr-only">Parola</label>
        <input
          id="gate-input"
          type="password"
          autocomplete="current-password"
          required
          class="w-full bg-bg-base border border-border focus:border-accent-1 outline-none px-3 py-2.5 text-text-100"
        />
        <p id="gate-error" class="text-sm text-accent-2 hidden" role="alert"></p>
        <button id="gate-submit" type="submit" class="w-full pill-btn pill-btn--primary justify-center">Giriş</button>
      </form>
    </div>

    <script>
      import { Marked } from 'marked';
      import { markedHighlight } from 'marked-highlight';
      import markedKatex from 'marked-katex-extension';
      import hljs from 'highlight.js/lib/common';
      import DOMPurify from 'dompurify';
      import { CHAT_EFFORTS, CHAT_MODELS, CHAT_WORKER_URL } from '@lib/constants';

      type Role = 'user' | 'assistant';
      type Kind = 'image' | 'document' | 'container';
      interface Attachment {
        ref: string; // signed by the Worker; never a bare file_id
        kind: Kind;
        name: string;
        expiresAt: string | null;
        thumb?: string; // small JPEG data URL, images only
      }
      interface Source { url: string; title: string }
      interface OutputFile { id: string; name: string } // made by code execution
      interface Usage { model: string; input: number; output: number; cost: number; context: number }
      interface Message {
        role: Role;
        content: string;
        at?: number; // when it was sent; older messages have none
        attachments?: Attachment[]; // user messages
        thinking?: string; // assistant: summarized thinking, display only
        sources?: Source[]; // assistant: web pages it cited
        steps?: string[]; // assistant: tools it used ("searched …")
        searches?: string[]; // older replies: web queries it ran
        files?: OutputFile[]; // assistant: files it made
        usage?: Usage;
      }
      interface Convo {
        id: string;
        title: string;
        updatedAt: number;
        messages: Message[] | null; // null = only the list entry is cached
        synced?: boolean; // saved on the server as-is
        titled?: boolean; // got its generated title
        projectId?: string | null;
        summary?: { text: string; upto: number } | null; // messages[0..upto) summarized
        containerId?: string | null; // code execution sandbox to reuse
        context?: number; // tokens the model read on the last reply
      }
      interface Project { id: string; name: string; instructions: string; files: Attachment[] }
      interface Pending {
        id: string;
        name: string;
        status: 'uploading' | 'ready' | 'error';
        error?: string;
        att?: Attachment;
        thumb?: string;
      }

      const KEY_TOKEN = 'fx-chat-token';
      const KEY_TOKEN_AT = 'fx-chat-token-at';
      const KEY_USER = 'fx-chat-user';
      const KEY_LEGACY_CONVOS = 'fx-chat-convos'; // before server history
      const KEY_LEGACY_ACTIVE = 'fx-chat-active';
      const KEY_MODEL = 'fx-chat-model';
      const KEY_EFFORT = 'fx-chat-effort';
      const KEY_WEB = 'fx-chat-web';
      const KEY_CODE = 'fx-chat-code';
      // Each device asks for the password again after this long. The Worker
      // still accepts it afterwards; this only makes the browser forget it.
      const TOKEN_MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000;
      const EXPIRED_MSG = 'Güvenlik için parola 30 günde bir soruluyor. Tekrar gir.';
      const MIGRATE_MSG = 'Sohbet geçmişi artık hesabına kaydediliyor. Bu cihazdaki sohbetleri kendi hesabına taşımak için kendi parolanı gir.';
      const MAX_CONVOS = 200;
      const MAX_ATTACHMENTS = 5; // per message; the Worker enforces the same
      const MAX_FILE_BYTES = 15 * 1024 * 1024;
      const MAX_TEXT_BYTES = 512 * 1024; // ~130k tokens, re-sent every turn
      const IMAGE_MAX_SIDE = 2048; // the API downsizes larger images anyway
      const IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
      const TEXT_EXT = /\.(txt|md|markdown|csv|tsv|json|xml|html?|css|js|ts|py|cs|java|c|cpp|h|sql|ya?ml|log)$/i;
      // Office files go to the code sandbox, which reads them with Python.
      const OFFICE: [RegExp, string][] = [
        [/\.xlsx$/i, 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'],
        [/\.xls$/i, 'application/vnd.ms-excel'],
        [/\.docx$/i, 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'],
        [/\.pptx$/i, 'application/vnd.openxmlformats-officedocument.presentationml.presentation'],
      ];
      const CONTEXT_WINDOW = 1_000_000; // every model in CHAT_MODELS
      // Long chats: once the model reads this much, older messages are
      // summarized (keeping the last few as they are) so replies stay fast,
      // cheap and sharp.
      const COMPACT_AT_TOKENS = 120_000;
      const COMPACT_AT_MESSAGES = 120;
      const KEEP_AFTER_COMPACT = 6;
      const SYNC_EVERY_MS = 30_000; // re-check the server when the tab comes back
      const SAVE_RETRY_MS = 20_000; // after a save that didn't reach the server
      const NOT_CONFIGURED = CHAT_WORKER_URL.includes('YOUR-SUBDOMAIN');
      const TYPING_HTML = '<span class="typing" aria-label="Yazıyor"><i></i><i></i><i></i></span>';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const scroller = $<HTMLElement>('scroller');
      const list = $<HTMLDivElement>('messages');
      const form = $<HTMLFormElement>('composer');
      const input = $<HTMLTextAreaElement>('input');
      const sendBtn = $<HTMLButtonElement>('send-btn');
      const stopBtn = $<HTMLButtonElement>('stop-btn');
      const micBtn = $<HTMLButtonElement>('mic-btn');
      const modelSelect = $<HTMLSelectElement>('model-select');
      const effortSelect = $<HTMLSelectElement>('effort-select');
      const webBtn = $<HTMLButtonElement>('web-btn');
      const codeBtn = $<HTMLButtonElement>('code-btn');
      const meter = $<HTMLSpanElement>('meter');
      const attachBtn = $<HTMLButtonElement>('attach-btn');
      const fileInput = $<HTMLInputElement>('file-input');
      const tray = $<HTMLDivElement>('attach-tray');
      const projectLabel = $<HTMLSpanElement>('project-label');
      const drawer = $<HTMLElement>('drawer');
      const backdrop = $<HTMLDivElement>('drawer-backdrop');
      const historyBtn = $<HTMLButtonElement>('history-btn');
      const projectSelect = $<HTMLSelectElement>('project-select');
      const projectEditBtn = $<HTMLButtonElement>('project-edit-btn');
      const convoList = $<HTMLUListElement>('convo-list');
      const convoSearch = $<HTMLInputElement>('convo-search');
      const usageLine = $<HTMLParagraphElement>('usage-line');
      const syncStatus = $<HTMLParagraphElement>('sync-status');
      const settingsDialog = $<HTMLDialogElement>('settings-dialog');
      const settingsForm = $<HTMLFormElement>('settings-form');
      const settingsInput = $<HTMLTextAreaElement>('settings-input');
      const settingsMemory = $<HTMLInputElement>('settings-memory');
      const settingsName = $<HTMLInputElement>('settings-name');
      const prefThinking = $<HTMLInputElement>('pref-thinking');
      const prefCost = $<HTMLInputElement>('pref-cost');
      const settingsError = $<HTMLParagraphElement>('settings-error');
      const settingsSave = $<HTMLButtonElement>('settings-save');
      const memoryDialog = $<HTMLDialogElement>('memory-dialog');
      const memoryList = $<HTMLDivElement>('memory-list');
      const projectDialog = $<HTMLDialogElement>('project-dialog');
      const projectForm = $<HTMLFormElement>('project-form');
      const projectName = $<HTMLInputElement>('project-name');
      const projectInstructions = $<HTMLTextAreaElement>('project-instructions');
      const projectFilesEl = $<HTMLDivElement>('project-files');
      const projectFileInput = $<HTMLInputElement>('project-file-input');
      const projectError = $<HTMLParagraphElement>('project-error');
      const gate = $<HTMLDivElement>('gate');
      const gateForm = $<HTMLFormElement>('gate-form');
      const gateInput = $<HTMLInputElement>('gate-input');
      const gateError = $<HTMLParagraphElement>('gate-error');
      const gateSubmit = $<HTMLButtonElement>('gate-submit');
      const chatMain = $<HTMLElement>('chat-main');
      const chatTitle = $<HTMLSpanElement>('chat-title');
      const greetingEl = $<HTMLSpanElement>('greeting');
      const userName = $<HTMLSpanElement>('user-name');
      const userAvatar = $<HTMLSpanElement>('user-avatar');
      const sidebarSection = document.querySelector<HTMLElement>('.sidebar-section')!;
      // Fallback names until a person sets their own in Ayarlar.
      const USER_NAMES: Record<string, string> = { kaan: 'Kaan' };
      let displayName = '';
      const nameOf = () => displayName || (user ? USER_NAMES[user] ?? '' : '');
      const wide = matchMedia('(min-width: 900px)');

      // ─── Markdown (highlighted, with math; sanitized) ──────────────────
      const md = new Marked(
        markedHighlight({
          emptyLangClass: 'hljs',
          langPrefix: 'hljs language-',
          highlight(code, lang) {
            const language = hljs.getLanguage(lang) ? lang : 'plaintext';
            return hljs.highlight(code, { language }).value;
          },
        }),
        // MathML output: the browser draws it natively, so no inline styles
        // or font files are needed and DOMPurify can keep it as-is.
        markedKatex({ throwOnError: false, output: 'mathml', nonStandard: true }),
        { gfm: true, breaks: true },
      );
      DOMPurify.addHook('afterSanitizeAttributes', (node) => {
        if (node.tagName === 'A') {
          node.setAttribute('target', '_blank');
          node.setAttribute('rel', 'noopener noreferrer nofollow');
        }
      });
      // Model output is untrusted: marked turns it into HTML (including any
      // raw HTML the model wrote), DOMPurify strips anything executable.
      function renderMarkdown(text: string): string {
        const html = md.parse(text, { async: false }) as string;
        return DOMPurify.sanitize(html, {
          // KaTeX wraps each formula's TeX source in <semantics><annotation>;
          // without these two the source text leaks out next to the formula.
          ADD_TAGS: ['semantics', 'annotation'],
          FORBID_TAGS: ['style', 'form', 'input', 'button', 'textarea', 'select', 'img', 'iframe'],
          FORBID_ATTR: ['style'],
        });
      }

      // ─── Storage (every access guarded; private mode can throw) ────────
      function load<T>(key: string, fallback: T): T {
        try {
          const raw = localStorage.getItem(key);
          return raw ? (JSON.parse(raw) as T) : fallback;
        } catch {
          return fallback;
        }
      }
      function save(key: string, value: unknown): boolean {
        try {
          localStorage.setItem(key, typeof value === 'string' ? value : JSON.stringify(value));
          return true;
        } catch {
          return false;
        }
      }
      function remove(key: string) {
        try { localStorage.removeItem(key); } catch {}
      }
      const read = (key: string) => { try { return localStorage.getItem(key); } catch { return null; } };

      let tokenExpired = false;
      function getToken(): string {
        try {
          const token = localStorage.getItem(KEY_TOKEN) ?? '';
          const savedAt = Number(localStorage.getItem(KEY_TOKEN_AT));
          if (token && Date.now() - savedAt < TOKEN_MAX_AGE_MS) return token;
          if (token) {
            forgetToken();
            tokenExpired = true;
          }
        } catch {}
        return '';
      }
      function rememberToken(token: string) {
        save(KEY_TOKEN, token);
        save(KEY_TOKEN_AT, String(Date.now()));
        tokenExpired = false;
      }
      function forgetToken() {
        remove(KEY_TOKEN);
        remove(KEY_TOKEN_AT);
      }
      // Sent URL-encoded: headers only carry Latin-1, so a raw ö/ş/ğ/ı would
      // be mangled or rejected. The Worker decodes and NFC-normalizes it.
      const authHeader = (token: string) => `Bearer ${encodeURIComponent(token.normalize('NFC'))}`;

      // All Worker calls except chat streaming go through here.
      async function api(path: string, init: RequestInit = {}): Promise<Response> {
        const headers = new Headers(init.headers);
        headers.set('Authorization', authHeader(getToken()));
        const res = await fetch(`${CHAT_WORKER_URL}${path}`, { ...init, headers });
        if (res.status === 401) {
          forgetToken();
          showGate('Parola hatalı. Tekrar dene.');
        }
        return res;
      }

      // ─── Formatting ────────────────────────────────────────────────────
      const nf = new Intl.NumberFormat('tr-TR');
      const tokens = (n: number) => (n >= 1000 ? `${(n / 1000).toLocaleString('tr-TR', { maximumFractionDigits: 1 })}k` : nf.format(n));
      const money = (n: number) => `$${n.toLocaleString('tr-TR', { minimumFractionDigits: n < 0.1 ? 3 : 2, maximumFractionDigits: n < 0.1 ? 3 : 2 })}`;
      const clock = new Intl.DateTimeFormat('tr-TR', { hour: '2-digit', minute: '2-digit' });
      const dayMonth = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short' });
      const fullDay = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
      // "14:32", "Dün", "12 Eki", "12 Eki 2025"; with `time` the older ones get the hour too.
      function when(ts: number, time = false): string {
        const d = new Date(ts);
        const now = new Date();
        const days = Math.round((new Date(now).setHours(0, 0, 0, 0) - new Date(ts).setHours(0, 0, 0, 0)) / 86_400_000);
        if (days === 0) return clock.format(d);
        const day = days === 1 ? 'Dün' : d.getFullYear() === now.getFullYear() ? dayMonth.format(d) : fullDay.format(d);
        return time ? `${day} ${clock.format(d)}` : day;
      }
      function timeEl(ts: number): HTMLElement {
        const el = document.createElement('time');
        el.className = 'msg-time';
        el.dateTime = new Date(ts).toISOString();
        el.textContent = when(ts, true);
        return el;
      }
      // claude-opus-5-5 → Opus 5.5
      const modelName = (id: string) => {
        const [, family = id, ...v] = id.split('-');
        return `${family.charAt(0).toUpperCase()}${family.slice(1)} ${v.join('.')}`.trim();
      };

      // ─── State ─────────────────────────────────────────────────────────
      let user: string | null = null;
      let convos: Convo[] = [];
      let activeId: string | null = null;
      let streaming: AbortController | null = null;
      let pending: Pending[] = [];
      let projects: Project[] = [];
      let currentProject: string | null = null; // the drawer's filter / new-chat target

      const convosKey = () => `fx-chat-convos:${user}`;
      const activeKey = () => `fx-chat-active:${user}`;
      const projectKey = () => `fx-chat-project:${user}`;
      const active = () => convos.find((c) => c.id === activeId) ?? null;
      const projectOf = (id?: string | null) => projects.find((p) => p.id === id) ?? null;

      function persist() {
        if (!user) return;
        convos.sort((a, b) => b.updatedAt - a.updatedAt);
        convos = convos.slice(0, MAX_CONVOS);
        if (!save(convosKey(), convos)) {
          // Storage full. The server has everything that's synced, so keep
          // only list entries for those (except the open chat), and drop
          // thumbnails from the rest.
          for (const c of convos) {
            if (c.id === activeId) continue;
            if (c.synced) c.messages = null;
            else c.messages?.forEach((m) => m.attachments?.forEach((a) => delete a.thumb));
          }
          save(convosKey(), convos);
        }
        if (activeId) save(activeKey(), activeId);
        else remove(activeKey());
      }

      function loadLocal() {
        convos = load<Convo[]>(convosKey(), []).filter((c) => c && c.id);
        activeId = read(activeKey());
        currentProject = read(projectKey());
        // One-time move of chats saved before server history existed.
        const legacy = load<Convo[]>(KEY_LEGACY_CONVOS, []);
        if (legacy.length) {
          for (const c of legacy) {
            if (c?.id && Array.isArray(c.messages) && !convos.some((x) => x.id === c.id)) {
              convos.push({ ...c, synced: false, titled: true });
            }
          }
          remove(KEY_LEGACY_CONVOS);
          remove(KEY_LEGACY_ACTIVE);
          persist();
        }
        if (activeId && !active()) activeId = null;
      }

      // ─── Server sync ───────────────────────────────────────────────────
      let lastSync = 0;
      let syncing = false;

      async function sync() {
        if (!user || syncing) return;
        syncing = true;
        const startedAt = Date.now();
        lastSync = startedAt;
        setSyncStatus('Eşitleniyor…');
        try {
          const res = await api('/convos');
          if (!res.ok) throw new Error(String(res.status));
          const { items } = (await res.json()) as {
            items: { id: string; title: string; updatedAt: number; projectId: string | null }[];
          };
          const onServer = new Map(items.map((i) => [i.id, i]));

          // Gone from the server but saved there before = deleted elsewhere.
          // (A chat saved after this list was read isn't in it yet.)
          convos = convos.filter(
            (c) => !(c.synced && !onServer.has(c.id) && c.updatedAt < startedAt) || (streaming && c.id === activeId),
          );
          for (const item of items) {
            const local = convos.find((c) => c.id === item.id);
            if (!local) {
              convos.push({ ...item, messages: null, synced: true, titled: true });
            } else if (item.updatedAt > local.updatedAt && !(streaming && local.id === activeId)) {
              Object.assign(local, { ...item, messages: null, synced: true });
            } else if (item.updatedAt < local.updatedAt) {
              local.synced = false;
            }
          }
          for (const c of convos) if (!onServer.has(c.id)) c.synced = false;
          if (activeId && !active()) activeId = null;
          persist();
          renderConvoList();

          const open = active();
          if (open && open.messages === null) await loadFull(open);
          else if (!streaming) renderConversation();

          // Upload local changes one by one (keeps under the rate limit).
          for (const c of convos.filter((x) => !x.synced && x.messages)) {
            if (!(await push(c))) break;
          }
          setSyncStatus(convos.some((c) => !c.synced) ? 'Bazı sohbetler henüz kaydedilmedi.' : 'Tüm sohbetler hesabına kayıtlı.');
        } catch {
          setSyncStatus('Sunucuya ulaşılamadı; bu cihazdaki kopya gösteriliyor.');
          retrySync();
        } finally {
          syncing = false;
        }
      }

      // A failed save stays on this device, so try again until it lands.
      let retryTimer = 0;
      function retrySync() {
        if (retryTimer) return;
        retryTimer = window.setTimeout(() => {
          retryTimer = 0;
          if (streaming) retrySync();
          else void sync();
        }, SAVE_RETRY_MS);
      }
      addEventListener('online', () => {
        if (user && convos.some((c) => !c.synced)) void sync();
      });

      async function loadFull(c: Convo) {
        if (c.id === activeId) renderConversation();
        try {
          const res = await api(`/convos/${c.id}`);
          if (res.status === 404) {
            convos = convos.filter((x) => x !== c);
            if (activeId === c.id) activeId = null;
          } else if (res.ok) {
            const data = await res.json();
            const saved = data.conversation ?? {};
            Object.assign(c, {
              title: data.title,
              updatedAt: data.updatedAt,
              projectId: data.projectId ?? null,
              messages: saved.messages ?? [],
              summary: saved.summary ?? null,
              containerId: saved.containerId ?? null,
              context: saved.context ?? 0,
              synced: true,
            });
          }
        } catch {}
        persist();
        renderConvoList();
        if (!streaming) renderConversation();
      }

      // Save one conversation; returns false when the server can't be used now.
      async function push(c: Convo): Promise<boolean> {
        if (!c.messages) return true;
        const savedAt = c.updatedAt;
        const q = new URLSearchParams({ updatedAt: String(savedAt) });
        if (c.projectId) q.set('projectId', c.projectId);
        try {
          const res = await api(`/convos/${c.id}?${q}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Title': encodeURIComponent(c.title) },
            body: JSON.stringify({
              messages: c.messages,
              summary: c.summary ?? null,
              containerId: c.containerId ?? null,
              context: c.context ?? 0,
            }),
          });
          if (res.ok && c.updatedAt === savedAt) {
            c.synced = true;
            persist();
          }
          if (!res.ok && res.status !== 413) retrySync();
          return res.ok || res.status === 413;
        } catch {
          retrySync();
          return false;
        }
      }

      function touch(c: Convo) {
        c.updatedAt = Date.now();
        c.synced = false;
        persist();
        void push(c);
      }

      function removeConvo(c: Convo) {
        deleteFiles(refsOf([c]));
        convos = convos.filter((x) => x.id !== c.id);
        if (activeId === c.id) activeId = null;
        persist();
        void api(`/convos/${c.id}`, { method: 'DELETE' }).catch(() => {});
      }

      function setSyncStatus(text: string) {
        syncStatus.textContent = text;
      }

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && user && !streaming && Date.now() - lastSync > SYNC_EVERY_MS) {
          void sync();
        }
      });

      // ─── Projects ──────────────────────────────────────────────────────
      async function loadProjects() {
        try {
          const res = await api('/projects');
          if (res.ok) projects = (await res.json()).items ?? [];
        } catch {}
        if (currentProject && !projectOf(currentProject)) currentProject = null;
        renderProjectSelect();
        renderProjectLabel();
        renderConvoList();
      }

      function renderProjectSelect() {
        projectSelect.replaceChildren();
        const opt = (value: string, label: string) => {
          const o = document.createElement('option');
          o.value = value;
          o.textContent = label;
          projectSelect.append(o);
        };
        opt('', 'Proje yok');
        for (const p of projects) opt(p.id, `📁 ${p.name}`);
        opt('__new', '+ Yeni proje');
        sidebarSection.textContent = currentProject ? `${projectOf(currentProject)?.name ?? 'Proje'} sohbetleri` : 'Son sohbetler';
      }

      function renderProjectLabel() {
        const p = projectOf(active()?.projectId ?? currentProject);
        projectLabel.hidden = !p;
        projectLabel.textContent = p ? ` · ${p.name}` : '';
        projectSelect.value = p?.id ?? '';
        projectEditBtn.hidden = !p;
      }

      projectSelect.addEventListener('change', () => {
        if (projectSelect.value === '__new') {
          renderProjectLabel();
          openProjectDialog(null);
          return;
        }
        if (streaming) return renderProjectLabel();
        // The picker sits above the composer: a change means "work there",
        // so the open chat gives way to a new one in that project.
        if (active()) {
          activeId = null;
          persist();
          renderConversation();
        }
        currentProject = projectSelect.value || null;
        if (currentProject) save(projectKey(), currentProject);
        else remove(projectKey());
        renderProjectSelect();
        renderConvoList();
        renderProjectLabel();
      });
      projectEditBtn.addEventListener('click', () => openProjectDialog(projectOf(projectSelect.value)));

      let editing: { id: string; files: Attachment[]; removed: string[]; uploading: number } | null = null;

      function openProjectDialog(p: Project | null) {
        closeDrawer();
        editing = { id: p?.id ?? crypto.randomUUID(), files: [...(p?.files ?? [])], removed: [], uploading: 0 };
        projectName.value = p?.name ?? '';
        projectInstructions.value = p?.instructions ?? '';
        $<HTMLButtonElement>('project-delete').hidden = !p;
        projectError.classList.add('hidden');
        renderProjectFiles();
        projectDialog.showModal();
      }

      function renderProjectFiles() {
        projectFilesEl.replaceChildren();
        if (!editing) return;
        for (const f of editing.files) {
          const chip = document.createElement('div');
          chip.className = 'tray-chip is-ready';
          const label = document.createElement('span');
          label.className = 'tray-name';
          label.textContent = `${f.kind === 'image' ? '🖼' : '📄'} ${f.name}`;
          const del = document.createElement('button');
          del.type = 'button';
          del.className = 'tray-del';
          del.setAttribute('aria-label', `${f.name} dosyasını kaldır`);
          del.textContent = '×';
          del.addEventListener('click', () => {
            editing!.files = editing!.files.filter((x) => x !== f);
            editing!.removed.push(f.ref);
            renderProjectFiles();
          });
          chip.append(label, del);
          projectFilesEl.append(chip);
        }
        if (editing.uploading) {
          const note = document.createElement('span');
          note.className = 'tray-state';
          note.textContent = `${editing.uploading} dosya yükleniyor…`;
          projectFilesEl.append(note);
        }
      }

      $<HTMLButtonElement>('project-add-file').addEventListener('click', () => projectFileInput.click());
      projectFileInput.addEventListener('change', async () => {
        const files = Array.from(projectFileInput.files ?? []);
        projectFileInput.value = '';
        for (const file of files) {
          if (!editing) return;
          if (editing.files.length + editing.uploading >= 10) break;
          const info = classify(file);
          if (!info) continue;
          editing.uploading += 1;
          renderProjectFiles();
          try {
            const att = await uploadFile(file, info, true);
            editing?.files.push(att);
          } catch (err) {
            projectError.textContent = `${file.name}: ${(err as Error).message}`;
            projectError.classList.remove('hidden');
          } finally {
            if (editing) editing.uploading -= 1;
            renderProjectFiles();
          }
        }
      });
      $<HTMLButtonElement>('project-cancel').addEventListener('click', () => projectDialog.close());
      $<HTMLButtonElement>('project-delete').addEventListener('click', async () => {
        if (!editing || !confirm('Proje ve dosyaları silinsin mi? Sohbetler kalır.')) return;
        await api(`/projects/${editing.id}`, { method: 'DELETE' }).catch(() => {});
        if (currentProject === editing.id) currentProject = null;
        convos.forEach((c) => c.projectId === editing!.id && (c.projectId = null));
        projectDialog.close();
        await loadProjects();
      });
      projectForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!editing) return;
        if (editing.uploading) {
          projectError.textContent = 'Dosyalar yükleniyor, birazdan kaydet.';
          projectError.classList.remove('hidden');
          return;
        }
        try {
          const res = await api(`/projects/${editing.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: projectName.value, instructions: projectInstructions.value, files: editing.files }),
          });
          if (!res.ok) throw new Error(await errorMessage(res));
          deleteFiles(editing.removed);
          currentProject = editing.id;
          save(projectKey(), currentProject);
          projectDialog.close();
          await loadProjects();
        } catch (err) {
          projectError.textContent = (err as Error).message || 'Kaydedilemedi.';
          projectError.classList.remove('hidden');
        }
      });

      // ─── Rendering ─────────────────────────────────────────────────────
      const isExpired = (a: Attachment) => !!a.expiresAt && Date.parse(a.expiresAt) <= Date.now();

      function attachmentsEl(atts: Attachment[]): HTMLElement {
        const row = document.createElement('div');
        row.className = 'msg-atts';
        for (const a of atts) {
          const expired = isExpired(a);
          if (a.kind === 'image' && a.thumb) {
            const img = document.createElement('img');
            img.className = `msg-thumb${expired ? ' is-expired' : ''}`;
            img.src = a.thumb.startsWith('data:image/') ? a.thumb : '';
            img.alt = a.name;
            img.title = expired ? `${a.name} (süresi doldu)` : a.name;
            row.append(img);
          } else {
            const chip = document.createElement('span');
            chip.className = `att-chip${expired ? ' is-expired' : ''}`;
            chip.textContent = `${a.kind === 'image' ? '🖼' : '📄'} ${a.name}${expired ? ' · süresi doldu' : ''}`;
            row.append(chip);
          }
        }
        return row;
      }

      function actionBtn(label: string, onClick: (btn: HTMLButtonElement) => void): HTMLButtonElement {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'msg-action';
        btn.textContent = label;
        btn.addEventListener('click', () => onClick(btn));
        return btn;
      }

      function userEl(m: Message, isLast: boolean, unanswered: boolean): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = 'flex flex-col items-end';
        const bubble = document.createElement('div');
        bubble.className = 'msg-user';
        if (m.attachments?.length) bubble.append(attachmentsEl(m.attachments));
        if (m.content) {
          const text = document.createElement('div');
          text.textContent = m.content; // plain text, never HTML
          bubble.append(text);
        }
        wrap.append(bubble);
        if (isLast || m.at) {
          const actions = document.createElement('div');
          actions.className = 'msg-actions';
          if (m.at) actions.append(timeEl(m.at));
          if (isLast) actions.append(actionBtn('Düzenle', () => editLast()));
          if (unanswered) actions.append(actionBtn('Yanıt iste', () => void retryReply()));
          wrap.append(actions);
        }
        return wrap;
      }

      // Generated files: images preview inline, everything downloads.
      const outputUrls = new Map<string, Promise<string>>();
      function outputUrl(f: OutputFile) {
        if (!outputUrls.has(f.id)) {
          outputUrls.set(
            f.id,
            api(`/outputs/${f.id}`).then(async (res) => {
              if (!res.ok) throw new Error(await errorMessage(res));
              return URL.createObjectURL(await res.blob());
            }),
          );
        }
        return outputUrls.get(f.id)!.catch((err) => {
          outputUrls.delete(f.id);
          throw err;
        });
      }

      function filesEl(files: OutputFile[]): HTMLElement {
        const row = document.createElement('div');
        row.className = 'out-files';
        for (const f of files) {
          if (/\.(png|jpe?g|gif|webp)$/i.test(f.name)) {
            const img = document.createElement('img');
            img.className = 'out-image';
            img.alt = f.name;
            void outputUrl(f).then((u) => (img.src = u)).catch(() => img.remove());
            row.append(img);
          }
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'att-chip out-chip';
          btn.textContent = `⬇ ${f.name}`;
          btn.addEventListener('click', async () => {
            try {
              const a = document.createElement('a');
              a.href = await outputUrl(f);
              a.download = f.name;
              a.click();
            } catch (err) {
              btn.textContent = `⚠ ${(err as Error).message}`;
            }
          });
          row.append(btn);
        }
        return row;
      }

      // One builder for both saved and streaming replies, so they look alike.
      function assistantView(m: Message) {
        const root = document.createElement('div');
        root.className = 'msg-assistant';
        const thinking = document.createElement('details');
        thinking.className = 'thinking';
        const summary = document.createElement('summary');
        summary.textContent = 'Düşünce özeti';
        const thinkingBody = document.createElement('div');
        thinkingBody.className = 'thinking-body';
        thinking.append(summary, thinkingBody);
        const status = document.createElement('div');
        status.className = 'tool-status';
        const body = document.createElement('div');
        body.className = 'prose-content chat-md';
        const files = document.createElement('div');
        const sources = document.createElement('div');
        sources.className = 'sources';
        const meta = document.createElement('div');
        meta.className = 'msg-meta';
        root.append(thinking, status, body, files, sources, meta);

        const view = {
          root,
          setThinking(text: string) {
            thinking.hidden = !text;
            thinkingBody.textContent = text; // summary text, shown as plain text
          },
          setStatus(text: string) {
            status.hidden = !text;
            status.textContent = text;
          },
          setBody(text: string) {
            body.innerHTML = renderMarkdown(text);
          },
          setTyping() {
            body.innerHTML = TYPING_HTML;
          },
          setFiles(list: OutputFile[]) {
            files.replaceChildren(...(list.length ? [filesEl(list)] : []));
          },
          setSources(list: Source[]) {
            sources.replaceChildren();
            sources.hidden = list.length === 0;
            if (!list.length) return;
            const label = document.createElement('div');
            label.className = 'sources-label';
            label.textContent = 'Kaynaklar';
            sources.append(label);
            list.forEach((src, i) => {
              let href = '';
              try {
                const u = new URL(src.url);
                if (u.protocol === 'https:' || u.protocol === 'http:') href = u.href;
              } catch {}
              if (!href) return;
              const a = document.createElement('a');
              a.href = href;
              a.target = '_blank';
              a.rel = 'noopener noreferrer nofollow';
              a.textContent = `${i + 1}. ${src.title || new URL(href).hostname}`;
              sources.append(a);
            });
          },
          setMeta(u?: Usage) {
            meta.hidden = !u;
            if (u) meta.textContent = `${modelName(u.model)} · ${tokens(u.input)} → ${tokens(u.output)} token · ≈ ${money(u.cost)}`;
          },
          finish() {
            addCopyButtons(body);
          },
        };
        view.setThinking(m.thinking ?? '');
        view.setStatus(m.steps?.length ? m.steps.join(' · ') : m.searches?.length ? searchedLabel(m.searches) : '');
        view.setBody(m.content);
        view.setFiles(m.files ?? []);
        view.setSources(m.sources ?? []);
        view.setMeta(m.usage);
        return view;
      }

      const searchedLabel = (qs: string[]) => `🔎 Web'de arandı: ${qs.map((q) => `“${q}”`).join(', ')}`;

      function assistantEl(m: Message, isLast: boolean): HTMLElement {
        const view = assistantView(m);
        view.finish();
        const actions = document.createElement('div');
        actions.className = 'msg-actions';
        if (m.at) actions.append(timeEl(m.at));
        actions.append(
          actionBtn('Kopyala', async (btn) => {
            try {
              await navigator.clipboard.writeText(m.content);
              btn.textContent = 'Kopyalandı';
            } catch {
              btn.textContent = 'Kopyalanamadı';
            }
            setTimeout(() => (btn.textContent = 'Kopyala'), 1500);
          }),
        );
        if (isLast) actions.append(actionBtn('Yeniden oluştur', () => void regenerate()));
        view.root.append(actions);
        return view.root;
      }

      function summaryEl(c: Convo): HTMLElement {
        const box = document.createElement('details');
        box.className = 'summary-divider';
        const head = document.createElement('summary');
        head.textContent = `Yukarıdaki ${c.summary!.upto} mesaj özetlendi; Claude onları bu özetten hatırlıyor.`;
        const text = document.createElement('div');
        text.className = 'thinking-body';
        text.textContent = c.summary!.text;
        box.append(head, text);
        return box;
      }

      function addCopyButtons(root: HTMLElement) {
        root.querySelectorAll('pre').forEach((pre) => {
          if (pre.querySelector('.copy-btn')) return;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn';
          btn.textContent = 'Kopyala';
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
              btn.textContent = 'Kopyalandı';
            } catch {
              btn.textContent = 'Kopyalanamadı';
            }
            setTimeout(() => (btn.textContent = 'Kopyala'), 1500);
          });
          pre.append(btn);
        });
      }

      function noteEl(text: string, tone: 'muted' | 'error' = 'muted'): HTMLElement {
        const el = document.createElement('p');
        el.className = `chat-note ${tone === 'error' ? 'text-accent-2' : 'text-text-300'}`;
        el.textContent = text;
        return el;
      }

      function renderConversation() {
        const c = active();
        const msgs = c?.messages ?? [];
        const lastUser = msgs.map((m) => m.role).lastIndexOf('user');
        const nodes: HTMLElement[] = [];
        msgs.forEach((m, i) => {
          if (c?.summary && i === c.summary.upto) nodes.push(summaryEl(c));
          nodes.push(m.role === 'user' ? userEl(m, i === lastUser && i >= msgs.length - 2, i === msgs.length - 1) : assistantEl(m, i === msgs.length - 1));
        });
        list.replaceChildren(...nodes);
        if (c && c.messages === null) list.append(noteEl('Sohbet yükleniyor…'));
        setEmpty(!c);
        chatTitle.textContent = c?.title ?? '';
        renderMeter();
        renderProjectLabel();
        scrollToBottom(true);
      }

      function renderMeter() {
        const c = active();
        if (!c?.messages?.length) {
          meter.textContent = '';
          return;
        }
        const cost = c.messages.reduce((s, m) => s + (m.usage?.cost ?? 0), 0);
        const ctx = c.context ?? 0;
        const pct = Math.min(100, (ctx / CONTEXT_WINDOW) * 100);
        const context = ctx
          ? `Bağlam ${tokens(ctx)} / 1M (%${pct.toLocaleString('tr-TR', { maximumFractionDigits: 1 })})`
          : c.summary
            ? 'Bağlam özetlendi'
            : '';
        meter.textContent = [context, `bu sohbet ≈ ${money(cost)}`].filter(Boolean).join(' · ');
      }

      function renderConvoList() {
        convoList.replaceChildren();
        const q = convoSearch.value.trim().toLocaleLowerCase('tr');
        const shown = convos.filter(
          (c) =>
            (!currentProject || c.projectId === currentProject) &&
            (!q ||
              `${c.title} ${(c.messages ?? []).map((m) => m.content).join(' ')}`.toLocaleLowerCase('tr').includes(q)),
        );
        if (shown.length === 0) {
          const li = document.createElement('li');
          li.className = 'px-4 py-3 text-sm text-text-300';
          li.textContent = q ? 'Eşleşen sohbet yok.' : currentProject ? 'Bu projede henüz sohbet yok.' : 'Henüz sohbet yok.';
          convoList.append(li);
          return;
        }
        for (const c of shown) {
          const li = document.createElement('li');
          li.className = 'group flex items-center';
          const open = document.createElement('button');
          open.type = 'button';
          open.className = `convo-item ${c.id === activeId ? 'is-active' : ''}`;
          const p = !currentProject && projectOf(c.projectId);
          const title = document.createElement('span');
          title.className = 'convo-title';
          title.textContent = c.title || 'Yeni sohbet';
          const sub = document.createElement('span');
          sub.className = 'convo-sub';
          sub.textContent = [p && `📁 ${p.name}`, when(c.updatedAt)].filter(Boolean).join(' · ');
          open.append(title, sub);
          open.addEventListener('click', () => {
            if (streaming) return;
            activeId = c.id;
            persist();
            renderConvoList();
            closeDrawer();
            if (c.messages === null) void loadFull(c);
            else renderConversation();
          });
          const del = document.createElement('button');
          del.type = 'button';
          del.className = 'convo-del';
          del.setAttribute('aria-label', 'Sohbeti sil');
          del.textContent = '×';
          del.addEventListener('click', () => {
            if (streaming && c.id === activeId) return;
            if (!confirm('Bu sohbet silinsin mi? Tüm cihazlarından silinir.')) return;
            removeConvo(c);
            renderConversation();
            renderConvoList();
          });
          li.append(open, del);
          convoList.append(li);
        }
      }
      convoSearch.addEventListener('input', renderConvoList);

      function nearBottom() {
        return scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight < 80;
      }
      function scrollToBottom(force = false) {
        if (force || nearBottom()) scroller.scrollTop = scroller.scrollHeight;
      }

      // Empty chat: greeting and a centered composer (see .is-empty).
      function setEmpty(on: boolean) {
        chatMain.classList.toggle('is-empty', on);
        input.placeholder = on ? 'Bugün sana nasıl yardımcı olabilirim?' : 'Yanıtla…';
        if (on) {
          const h = new Date().getHours();
          const hello = h < 5 ? 'İyi geceler' : h < 11 ? 'Günaydın' : h < 18 ? 'İyi günler' : 'İyi akşamlar';
          const name = nameOf();
          greetingEl.textContent = name ? `${hello}, ${name}` : hello;
        }
      }

      function refreshUsage() {
        void api('/usage')
          .then((r) => (r.ok ? r.json() : null))
          .then((u) => {
            if (u) usageLine.textContent = `Bu ay ≈ ${money(u.cost)} · ${nf.format(u.requests)} istek`;
          })
          .catch(() => {});
      }

      // ─── Sidebar ───────────────────────────────────────────────────────
      // Wide screens: a column beside the chat that the same buttons
      // collapse and bring back. Narrow screens: a drawer over the chat.
      function openDrawer() {
        renderConvoList();
        if (wide.matches) {
          document.body.classList.remove('sidebar-collapsed');
        } else {
          drawer.classList.add('is-open');
          backdrop.classList.remove('hidden');
        }
        drawer.inert = false;
        historyBtn.setAttribute('aria-expanded', 'true');
      }
      function closeDrawer() {
        if (wide.matches) return;
        drawer.classList.remove('is-open');
        drawer.inert = true;
        backdrop.classList.add('hidden');
        historyBtn.setAttribute('aria-expanded', 'false');
      }
      function collapseSidebar() {
        if (!wide.matches) return closeDrawer();
        document.body.classList.add('sidebar-collapsed');
        drawer.inert = true;
        historyBtn.setAttribute('aria-expanded', 'false');
      }
      function syncSidebar() {
        const collapsed = document.body.classList.contains('sidebar-collapsed');
        drawer.inert = wide.matches ? collapsed : !drawer.classList.contains('is-open');
        if (wide.matches) backdrop.classList.add('hidden');
      }
      wide.addEventListener('change', syncSidebar);
      syncSidebar();
      historyBtn.addEventListener('click', openDrawer);
      backdrop.addEventListener('click', closeDrawer);
      $<HTMLButtonElement>('drawer-close').addEventListener('click', collapseSidebar);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-new-chat]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (streaming) return;
          activeId = null;
          persist();
          renderConversation();
          renderConvoList();
          closeDrawer();
          input.focus();
        }),
      );

      $<HTMLButtonElement>('clear-btn').addEventListener('click', () => {
        if (streaming) return;
        if (!confirm('Tüm sohbet geçmişin silinsin mi? Tüm cihazlarından silinir.')) return;
        for (const c of [...convos]) removeConvo(c);
        renderConversation();
        renderConvoList();
      });

      $<HTMLButtonElement>('export-btn').addEventListener('click', () => {
        const c = active();
        if (!c?.messages?.length) return;
        const out = [`# ${c.title || 'Sohbet'}`, ''];
        c.messages.forEach((m, i) => {
          if (c.summary && i === c.summary.upto) out.push('---', '_Önceki mesajların özeti:_', '', c.summary.text, '---', '');
          out.push(m.role === 'user' ? '## Sen' : '## Claude', '');
          if (m.attachments?.length) out.push(`_Ekler: ${m.attachments.map((a) => a.name).join(', ')}_`, '');
          out.push(m.content, '');
          if (m.files?.length) out.push(`_Üretilen dosyalar: ${m.files.map((f) => f.name).join(', ')}_`, '');
          if (m.sources?.length) out.push('Kaynaklar:', ...m.sources.map((s) => `- [${s.title || s.url}](${s.url})`), '');
        });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([out.join('\n')], { type: 'text/markdown;charset=utf-8' }));
        a.download = `${(c.title || 'sohbet').replace(/[\\/:*?"<>|]+/g, '-').slice(0, 60)}.md`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      });

      $<HTMLButtonElement>('logout-btn').addEventListener('click', async () => {
        streaming?.abort();
        // The server has everything synced; don't leave this person's chats
        // on a device someone else may use.
        if (user && convos.every((c) => c.synced)) {
          remove(convosKey());
          remove(activeKey());
        }
        forgetToken();
        remove(KEY_USER);
        user = null;
        displayName = '';
        renderIdentity();
        convos = [];
        projects = [];
        activeId = null;
        currentProject = null;
        renderProjectSelect();
        renderConversation();
        closeDrawer();
        showGate();
      });

      function renderIdentity() {
        const name = nameOf();
        userName.textContent = name || 'Hesabım';
        userAvatar.textContent = (name || '?').charAt(0).toLocaleUpperCase('tr');
        if (chatMain.classList.contains('is-empty')) setEmpty(true);
      }

      // ─── Device preferences (this browser only) ────────────────────────
      interface Prefs { font: 's' | 'm' | 'l'; enter: 'send' | 'newline'; thinking: boolean; cost: boolean }
      const KEY_PREFS = 'fx-chat-prefs';
      // On phones Enter usually means a new line; on computers it sends.
      const coarse = matchMedia('(pointer: coarse)').matches;
      const prefs: Prefs = { font: 'm', enter: coarse ? 'newline' : 'send', thinking: true, cost: true, ...load<Partial<Prefs>>(KEY_PREFS, {}) };

      function applyPrefs() {
        document.body.dataset.font = prefs.font;
        document.body.classList.toggle('hide-thinking', !prefs.thinking);
        document.body.classList.toggle('hide-cost', !prefs.cost);
        input.enterKeyHint = prefs.enter === 'send' ? 'send' : 'enter';
      }

      const currentTheme = () => (read('fx-theme') === 'light' || read('fx-theme') === 'dark' ? read('fx-theme')! : 'system');
      function applyTheme(choice: string) {
        if (choice === 'system') remove('fx-theme');
        else save('fx-theme', choice);
        const theme = choice === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : choice;
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#faf9f5' : '#262624');
      }
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        if (currentTheme() === 'system') applyTheme('system');
      });

      const radios = (name: string) => [...settingsForm.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
      const setRadio = (name: string, value: string) => radios(name).forEach((r) => (r.checked = r.value === value));
      // Appearance and chat preferences apply the moment they change.
      radios('theme').forEach((r) => r.addEventListener('change', () => applyTheme(r.value)));
      radios('font').forEach((r) => r.addEventListener('change', () => { prefs.font = r.value as Prefs['font']; save(KEY_PREFS, prefs); applyPrefs(); }));
      radios('enter').forEach((r) => r.addEventListener('change', () => { prefs.enter = r.value as Prefs['enter']; save(KEY_PREFS, prefs); applyPrefs(); }));
      prefThinking.addEventListener('change', () => { prefs.thinking = prefThinking.checked; save(KEY_PREFS, prefs); applyPrefs(); });
      prefCost.addEventListener('change', () => { prefs.cost = prefCost.checked; save(KEY_PREFS, prefs); applyPrefs(); });
      applyPrefs();
      applyTheme(currentTheme());

      // ─── Settings dialog ───────────────────────────────────────────────
      $<HTMLButtonElement>('settings-btn').addEventListener('click', async () => {
        closeDrawer();
        settingsError.classList.add('hidden');
        setRadio('theme', currentTheme());
        setRadio('font', prefs.font);
        setRadio('enter', prefs.enter);
        prefThinking.checked = prefs.thinking;
        prefCost.checked = prefs.cost;
        settingsName.value = displayName;
        settingsInput.value = '';
        settingsInput.placeholder = 'Yükleniyor…';
        settingsDialog.showModal();
        try {
          const res = await api('/settings');
          if (res.ok) {
            const s = await res.json();
            settingsName.value = s.name ?? '';
            settingsInput.value = s.instructions ?? '';
            settingsMemory.checked = s.memory !== false;
          }
        } catch {}
        settingsInput.placeholder = 'Claude sana nasıl yanıt versin?';
      });
      $<HTMLButtonElement>('settings-cancel').addEventListener('click', () => settingsDialog.close());
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        settingsSave.disabled = true;
        try {
          const res = await api('/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: settingsName.value, instructions: settingsInput.value, memory: settingsMemory.checked }),
          });
          if (!res.ok) throw new Error(await errorMessage(res));
          displayName = (await res.json()).name ?? '';
          if (user) save(`fx-chat-name:${user}`, displayName);
          renderIdentity();
          settingsDialog.close();
        } catch (err) {
          settingsError.textContent = (err as Error).message || 'Kaydedilemedi.';
          settingsError.classList.remove('hidden');
        } finally {
          settingsSave.disabled = false;
        }
      });

      // ─── Memory viewer ─────────────────────────────────────────────────
      async function renderMemory() {
        memoryList.replaceChildren(noteEl('Yükleniyor…'));
        try {
          const res = await api('/memory');
          if (!res.ok) throw new Error(await errorMessage(res));
          const { files } = (await res.json()) as { files: { path: string; content: string }[] };
          memoryList.replaceChildren();
          if (!files.length) memoryList.append(noteEl('Henüz bir not yok. Claude önemli bir şey öğrendiğinde buraya yazar.'));
          for (const f of files) {
            const item = document.createElement('div');
            item.className = 'memory-item';
            const head = document.createElement('div');
            head.className = 'memory-head';
            const name = document.createElement('span');
            name.textContent = f.path.replace(/^\/memories\//, '');
            const del = actionBtn('Sil', async () => {
              if (!confirm(`"${name.textContent}" notu silinsin mi?`)) return;
              await api(`/memory?path=${encodeURIComponent(f.path)}`, { method: 'DELETE' }).catch(() => {});
              void renderMemory();
            });
            head.append(name, del);
            const body = document.createElement('pre');
            body.className = 'memory-body';
            body.textContent = f.content;
            item.append(head, body);
            memoryList.append(item);
          }
        } catch (err) {
          memoryList.replaceChildren(noteEl((err as Error).message || 'Yüklenemedi.', 'error'));
        }
      }
      $<HTMLButtonElement>('memory-btn').addEventListener('click', () => {
        closeDrawer();
        memoryDialog.showModal();
        void renderMemory();
      });
      $<HTMLButtonElement>('memory-close').addEventListener('click', () => memoryDialog.close());

      // ─── Password gate ─────────────────────────────────────────────────
      function showGate(message = '') {
        gate.classList.remove('hidden');
        gateError.textContent = message;
        gateError.classList.toggle('hidden', !message);
        gateInput.value = '';
        gateInput.focus();
      }

      gateForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = gateInput.value.trim();
        if (!token) return;
        if (NOT_CONFIGURED) {
          showGate('Sohbet servisi henüz yapılandırılmadı.');
          return;
        }
        gateSubmit.disabled = true;
        gateSubmit.textContent = 'Kontrol ediliyor…';
        try {
          const res = await fetch(`${CHAT_WORKER_URL}/auth`, {
            headers: { Authorization: authHeader(token) },
          });
          if (res.ok) {
            rememberToken(token);
            gate.classList.add('hidden');
            const data = await res.json().catch(() => ({}));
            signIn(typeof data.user === 'string' ? data.user : 'partner');
          } else {
            showGate(await errorMessage(res));
          }
        } catch {
          showGate('Sunucuya ulaşılamadı. Bağlantını kontrol et.');
        } finally {
          gateSubmit.disabled = false;
          gateSubmit.textContent = 'Giriş';
        }
      });

      function signIn(id: string) {
        user = id;
        save(KEY_USER, id);
        displayName = read(`fx-chat-name:${id}`) ?? '';
        renderIdentity();
        refreshUsage();
        void api('/settings')
          .then((r) => (r.ok ? r.json() : null))
          .then((s) => {
            if (!s || user !== id) return;
            displayName = s.name ?? '';
            save(`fx-chat-name:${id}`, displayName);
            renderIdentity();
          })
          .catch(() => {});
        loadLocal();
        renderConversation();
        void sync();
        void loadProjects();
        input.focus();
      }

      async function errorMessage(res: Response): Promise<string> {
        try {
          const data = await res.json();
          if (typeof data?.error === 'string') return data.error;
        } catch {}
        return `Bir hata oluştu (${res.status}).`;
      }

      // ─── Composer ──────────────────────────────────────────────────────
      function autosize() {
        input.style.height = 'auto';
        input.style.height = `${Math.min(input.scrollHeight, 192)}px`;
      }
      input.addEventListener('input', autosize);
      input.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || e.shiftKey || e.isComposing) return;
        // Ctrl/Cmd+Enter always sends; plain Enter follows the setting.
        if (prefs.enter === 'send' || e.metaKey || e.ctrlKey) {
          e.preventDefault();
          form.requestSubmit();
        }
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        void send();
      });
      stopBtn.addEventListener('click', () => streaming?.abort());

      function setStreaming(on: boolean) {
        sendBtn.hidden = on;
        stopBtn.hidden = !on;
      }

      async function send() {
        stopDictation();
        const text = input.value.trim();
        if (streaming || !user) return;
        if (pending.some((p) => p.status === 'uploading')) {
          flashTray('Dosyalar yükleniyor, birazdan gönderebilirsin.');
          return;
        }
        const attachments = pending.flatMap((p) => (p.status === 'ready' && p.att ? [p.att] : []));
        if (!text && attachments.length === 0) return;
        if (!getToken()) return showGate(tokenExpired ? EXPIRED_MSG : '');

        let convo = active();
        if (convo && convo.messages === null) return; // still loading
        if (!convo) {
          const title = text || attachments.map((a) => a.name).join(', ');
          convo = {
            id: crypto.randomUUID(),
            title: title.slice(0, 60),
            updatedAt: Date.now(),
            messages: [],
            projectId: currentProject,
          };
          convos.unshift(convo);
          activeId = convo.id;
        }
        const userMsg: Message = { role: 'user', content: text, at: Date.now() };
        if (attachments.length) userMsg.attachments = attachments;
        convo.messages!.push(userMsg);
        touch(convo);

        input.value = '';
        autosize();
        pending = [];
        renderTray();
        renderConversation();
        await respond(convo, { text, attachments });
      }

      async function regenerate() {
        const c = active();
        if (streaming || !c?.messages?.length || c.messages.at(-1)!.role !== 'assistant') return;
        c.messages.pop();
        dropStaleSummary(c);
        touch(c);
        renderConversation();
        await respond(c, null);
      }

      // A message left without a reply (connection dropped, app closed).
      async function retryReply() {
        const c = active();
        if (streaming || c?.messages?.at(-1)?.role !== 'user') return;
        renderConversation();
        await respond(c, null);
      }

      function editLast() {
        const c = active();
        if (streaming || !c?.messages) return;
        const i = c.messages.map((m) => m.role).lastIndexOf('user');
        if (i < 0) return;
        const [m] = c.messages.splice(i);
        dropStaleSummary(c);
        touch(c);
        renderConversation();
        restoreDraft(m.content, m.attachments ?? []);
        input.focus();
      }

      function dropStaleSummary(c: Convo) {
        if (c.summary && c.summary.upto >= (c.messages?.length ?? 0)) c.summary = null;
      }

      // What the Worker gets: messages after the summary, with the summary
      // put in front of the first one.
      function apiMessages(c: Convo) {
        const start = c.summary?.upto ?? 0;
        const out = c.messages!.slice(start).map(toApiMessage);
        if (c.summary && out.length) {
          const first = out[0];
          const blocks = typeof first.content === 'string' ? [{ type: 'text', text: first.content }] : first.content;
          first.content = [
            { type: 'text', text: `<önceki_konuşmanın_özeti>\n${c.summary.text}\n</önceki_konuşmanın_özeti>` },
            ...blocks,
          ];
        }
        return out;
      }

      // Streams one reply for the conversation as it stands. `draft` is the
      // message just sent: if nothing comes back it's taken out again and put
      // back in the composer. Regenerate passes null and keeps the history.
      async function respond(convo: Convo, draft: { text: string; attachments: Attachment[] } | null) {
        const msg: Message = { role: 'assistant', content: '' };
        const view = assistantView(msg);
        view.setTyping();
        list.append(view.root);
        scrollToBottom(true);

        const controller = new AbortController();
        streaming = controller;
        setStreaming(true);

        let stopReason: string | null = null;
        let failure = '';
        let dropped = false;
        let frame = 0;
        const steps = { searches: [] as string[], fetches: [] as string[], code: 0, memoryRead: 0, memoryWrite: 0 };
        const tools = new Map<number, { name: string; json: string }>();
        const results: Source[] = [];
        const cited: Source[] = [];
        const addSource = (into: Source[], s: { url?: string; title?: string }) => {
          if (s?.url && !into.some((x) => x.url === s.url)) into.push({ url: s.url, title: s.title ?? '' });
        };
        const stepsText = () => {
          const parts: string[] = [];
          if (steps.searches.length) parts.push(searchedLabel(steps.searches));
          if (steps.fetches.length) parts.push(`🔗 Okunan sayfa: ${steps.fetches.join(', ')}`);
          if (steps.code) parts.push(`⚙️ Kod çalıştırıldı (${steps.code} adım)`);
          if (steps.memoryWrite) parts.push('🧠 Hafıza güncellendi');
          else if (steps.memoryRead) parts.push('🧠 Hafızaya bakıldı');
          return parts;
        };
        const paint = () => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            const stick = nearBottom();
            view.setThinking(msg.thinking ?? '');
            if (msg.content) view.setBody(msg.content);
            if (stick) scrollToBottom(true);
          });
        };
        const live: Record<string, string> = {
          web_search: "🔎 Web'de arıyor…",
          web_fetch: '🔗 Sayfayı okuyor…',
          bash_code_execution: '⚙️ Kod çalıştırıyor…',
          text_editor_code_execution: '⚙️ Dosya hazırlıyor…',
          memory: '🧠 Hafızaya bakıyor…',
        };

        try {
          const res = await fetch(CHAT_WORKER_URL, {
            method: 'POST',
            headers: { Authorization: authHeader(getToken()), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              messages: apiMessages(convo),
              model: modelSelect.value,
              effort: effortSelect.value,
              web: pressed(webBtn),
              code: pressed(codeBtn),
              projectId: convo.projectId ?? undefined,
              containerId: convo.containerId ?? undefined,
            }),
            signal: controller.signal,
          });

          if (res.status === 401) {
            failure = 'Parola hatalı.';
            forgetToken();
            showGate('Parola hatalı. Tekrar dene.');
          } else if (!res.ok || !res.body) {
            failure = await errorMessage(res);
          } else {
            for await (const event of readSSE(res.body)) {
              const block = event.content_block;
              const delta = event.delta;
              if (event.type === 'message_start') {
                tools.clear(); // each round of the turn restarts block indices
              } else if (event.type === 'content_block_start') {
                if (block?.type === 'server_tool_use' || block?.type === 'tool_use') {
                  tools.set(event.index, { name: block.name, json: '' });
                  if (live[block.name]) view.setStatus([...stepsText(), live[block.name]].join(' · '));
                } else if (block?.type === 'web_search_tool_result' && Array.isArray(block.content)) {
                  block.content.forEach((r: Source) => addSource(results, r));
                } else if (block?.type === 'text' && msg.content && !msg.content.endsWith('\n')) {
                  msg.content += '\n\n'; // keep text before and after a tool call apart
                }
              } else if (event.type === 'content_block_delta') {
                if (delta?.type === 'text_delta') {
                  msg.content += delta.text;
                  paint();
                } else if (delta?.type === 'thinking_delta') {
                  msg.thinking = (msg.thinking ?? '') + delta.thinking;
                  paint();
                } else if (delta?.type === 'citations_delta' && delta.citation?.url) {
                  addSource(cited, delta.citation);
                } else if (delta?.type === 'input_json_delta' && tools.has(event.index)) {
                  tools.get(event.index)!.json += delta.partial_json;
                }
              } else if (event.type === 'content_block_stop' && tools.has(event.index)) {
                const t = tools.get(event.index)!;
                tools.delete(event.index);
                let inputData: Record<string, unknown> = {};
                try {
                  inputData = JSON.parse(t.json || '{}');
                } catch {}
                if (t.name === 'web_search' && typeof inputData.query === 'string') steps.searches.push(inputData.query);
                else if (t.name === 'web_fetch' && typeof inputData.url === 'string') {
                  try {
                    steps.fetches.push(new URL(inputData.url).hostname);
                  } catch {}
                } else if (t.name === 'bash_code_execution' || t.name === 'text_editor_code_execution') steps.code += 1;
                else if (t.name === 'memory') {
                  if (inputData.command === 'view') steps.memoryRead += 1;
                  else steps.memoryWrite += 1;
                }
                view.setStatus(stepsText().join(' · '));
              } else if (event.type === 'message_delta' && delta?.stop_reason) {
                stopReason = delta.stop_reason;
              } else if (event.type === 'usage_summary') {
                msg.usage = {
                  model: event.model,
                  input: event.input + event.cacheRead + event.cacheWrite,
                  output: event.output,
                  cost: event.cost,
                  context: event.context,
                };
                if (Array.isArray(event.files) && event.files.length) msg.files = event.files;
                if (event.containerId) convo.containerId = event.containerId;
                if (event.context) convo.context = event.context;
              } else if (event.type === 'error') {
                failure =
                  event.error?.type === 'overloaded_error'
                    ? 'Servis şu an çok yoğun. Birazdan tekrar dene.'
                    : 'Yanıt alınırken bir hata oluştu.';
              }
            }
          }
        } catch (err) {
          if ((err as Error).name !== 'AbortError') {
            failure = 'Bağlantı koptu. Tekrar dene.';
            dropped = true;
          }
        } finally {
          streaming = null;
          setStreaming(false);
          cancelAnimationFrame(frame);
        }

        const sources = cited.length ? cited : results;
        const stepList = stepsText();
        if (msg.content.trim() || msg.files?.length) {
          if (sources.length) msg.sources = sources.slice(0, 12);
          if (stepList.length) msg.steps = stepList;
          msg.at = Date.now();
          convo.messages!.push(msg);
          touch(convo);
          renderConversation();
          const last = list.lastElementChild!;
          if (controller.signal.aborted) last.append(noteEl('Durduruldu.'));
          else if (stopReason === 'max_tokens') last.append(noteEl('Yanıt uzunluk sınırına ulaştı ve kesildi. Gücü artırıp yeniden oluşturabilirsin.'));
          else if (stopReason === 'refusal') last.append(noteEl('Yanıtın devamı engellendi.'));
          if (failure) last.append(noteEl(failure, 'error'));
          if (!convo.titled) void nameConvo(convo);
          refreshUsage();
          void maybeCompact(convo);
        } else {
          if (draft && !dropped) {
            // Nothing came back: drop the unanswered message and put it back
            // in the composer so it can be re-sent with one tap. A dropped
            // connection keeps it: phones cut streams when the app leaves the
            // foreground, and that must not delete the chat.
            convo.messages!.pop();
            if (convo.messages!.length === 0) removeConvo(convo);
            else touch(convo);
            restoreDraft(draft.text, draft.attachments);
          }
          renderConversation();
          if (!controller.signal.aborted) {
            const note =
              failure || (stopReason === 'refusal' ? 'Bu isteğe yanıt verilemedi.' : 'Boş yanıt geldi. Tekrar dene.');
            setEmpty(false);
            list.append(noteEl(note, 'error'));
            scrollToBottom(true);
          }
        }
        input.focus();
      }

      // Short title from the first message, made by Haiku on the Worker.
      async function nameConvo(c: Convo) {
        c.titled = true;
        const first = c.messages?.find((m) => m.role === 'user');
        const text = [first?.content, ...(first?.attachments?.map((a) => a.name) ?? [])].filter(Boolean).join('\n');
        if (!text) return;
        try {
          const res = await api('/title', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text }),
          });
          if (!res.ok) return;
          const { title } = await res.json();
          if (typeof title === 'string' && title) {
            c.title = title;
            touch(c);
            renderConvoList();
            if (c.id === activeId) chatTitle.textContent = title;
          }
        } catch {}
      }

      // Long chat: summarize everything but the last few messages. The
      // summary goes in front of the remaining messages from now on.
      let compacting = false;
      async function maybeCompact(c: Convo) {
        const msgs = c.messages ?? [];
        const start = c.summary?.upto ?? 0;
        if (compacting || ((c.context ?? 0) < COMPACT_AT_TOKENS && msgs.length - start < COMPACT_AT_MESSAGES)) return;
        let upto = msgs.length - KEEP_AFTER_COMPACT;
        while (upto > start && msgs[upto]?.role !== 'user') upto -= 1; // kept part starts with the person
        if (upto <= start) return;

        compacting = true;
        meter.textContent = 'Sohbet özetleniyor…';
        const transcript = [
          c.summary ? `Önceki özet:\n${c.summary.text}\n` : '',
          ...msgs.slice(start, upto).map((m) => {
            const files = m.attachments?.length ? ` [ekler: ${m.attachments.map((a) => a.name).join(', ')}]` : '';
            return `${m.role === 'user' ? 'Kişi' : 'Claude'}${files}: ${m.content}`;
          }),
        ].join('\n\n');
        try {
          const res = await api('/compact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: transcript }),
          });
          if (res.ok) {
            const { summary } = await res.json();
            if (typeof summary === 'string' && summary && c.messages === msgs) {
              c.summary = { text: summary, upto };
              c.context = 0;
              touch(c);
              if (c.id === activeId && !streaming) renderConversation();
            }
          }
        } catch {
        } finally {
          compacting = false;
          renderMeter();
        }
      }

      // ─── Attachments ───────────────────────────────────────────────────
      // The Worker wants text or blocks referencing its signed refs.
      // Expired files are swapped for a note so old chats keep working.
      function toApiMessage(m: Message): { role: Role; content: string | Record<string, string>[] } {
        if (!m.attachments?.length) return { role: m.role, content: m.content };
        const blocks = m.attachments.map((a): Record<string, string> =>
          isExpired(a)
            ? { type: 'text', text: `[Ek: ${a.name} — süresi dolduğu için artık kullanılamıyor]` }
            : a.kind === 'image'
              ? { type: 'image', ref: a.ref }
              : a.kind === 'container'
                ? { type: 'container_upload', ref: a.ref }
                : { type: 'document', ref: a.ref, title: a.name },
        );
        if (m.content) blocks.push({ type: 'text', text: m.content });
        return { role: m.role, content: blocks };
      }

      function refsOf(items: Convo[]): string[] {
        return items.flatMap((c) => (c.messages ?? []).flatMap((m) => m.attachments?.map((a) => a.ref) ?? []));
      }

      // Best effort: chat files also expire on their own after 90 days.
      function deleteFiles(refs: string[]) {
        for (const ref of refs) {
          void api(`/files/${encodeURIComponent(ref)}`, { method: 'DELETE' }).catch(() => {});
        }
      }

      function restoreDraft(text: string, attachments: Attachment[]) {
        input.value = text;
        autosize();
        pending = attachments.map((a) => ({ id: crypto.randomUUID(), name: a.name, status: 'ready', att: a, thumb: a.thumb }));
        renderTray();
      }

      function classify(file: File): { kind: Kind; type: string } | null {
        if (IMAGE_TYPES.includes(file.type)) return { kind: 'image', type: file.type };
        if (file.type === 'application/pdf' || /\.pdf$/i.test(file.name)) return { kind: 'document', type: 'application/pdf' };
        const office = OFFICE.find(([re]) => re.test(file.name));
        if (office) return { kind: 'container', type: office[1] };
        if (file.type.startsWith('text/') || file.type === 'application/json' || TEXT_EXT.test(file.name)) {
          return { kind: 'document', type: 'text/plain' };
        }
        return null;
      }

      async function drawScaled(file: Blob, maxSide: number, quality: number): Promise<Blob> {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const ctx = canvas.getContext('2d')!;
        ctx.fillStyle = '#fff'; // JPEG has no alpha; flatten onto white
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        return new Promise((resolve, reject) =>
          canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), 'image/jpeg', quality),
        );
      }

      const toDataUrl = (blob: Blob) =>
        new Promise<string>((resolve, reject) => {
          const r = new FileReader();
          r.onload = () => resolve(r.result as string);
          r.onerror = () => reject(r.error);
          r.readAsDataURL(blob);
        });

      async function isLarge(file: Blob): Promise<boolean> {
        try {
          const b = await createImageBitmap(file);
          const big = Math.max(b.width, b.height) > IMAGE_MAX_SIDE;
          b.close();
          return big;
        } catch {
          return false;
        }
      }

      // Uploads one file through the Worker; `keep` = project file, no expiry.
      async function uploadFile(file: File, info: { kind: Kind; type: string }, keep = false, thumb?: string): Promise<Attachment> {
        if (info.type === 'text/plain' && file.size > MAX_TEXT_BYTES) throw new Error('En fazla 512 KB');
        let body: Blob = file;
        let type = info.type;
        if (info.kind === 'image' && type !== 'image/gif' && (file.size > 3 * 1024 * 1024 || (await isLarge(file)))) {
          // GIFs keep their bytes (scaling would drop animation); others are
          // shrunk when big so phone photos upload quickly.
          body = await drawScaled(file, IMAGE_MAX_SIDE, 0.85);
          type = 'image/jpeg';
        }
        if (body.size > MAX_FILE_BYTES) throw new Error('En fazla 15 MB');
        if (!getToken()) throw new Error('Önce parolayı gir');
        const res = await api(`/files${keep ? '?keep=1' : ''}`, {
          method: 'POST',
          headers: { 'Content-Type': type, 'X-File-Name': encodeURIComponent(file.name || 'dosya') },
          body,
        });
        if (res.status === 401) throw new Error('Parola gerekli');
        if (!res.ok) throw new Error(await errorMessage(res));
        const data = await res.json();
        const att: Attachment = { ref: data.ref, kind: data.kind, name: file.name || 'dosya', expiresAt: data.expiresAt ?? null };
        if (thumb) att.thumb = thumb;
        return att;
      }

      function addFiles(files: Iterable<File>) {
        for (const file of files) {
          if (pending.length >= MAX_ATTACHMENTS) {
            flashTray(`Bir mesaja en fazla ${MAX_ATTACHMENTS} dosya eklenebilir.`);
            break;
          }
          const info = classify(file);
          const p: Pending = { id: crypto.randomUUID(), name: file.name || 'dosya', status: 'uploading' };
          pending.push(p);
          if (!info) Object.assign(p, { status: 'error', error: 'Desteklenmeyen tür' });
          else if (file.size > MAX_FILE_BYTES && info.kind !== 'image') Object.assign(p, { status: 'error', error: 'En fazla 15 MB' });
          else void uploadPending(p, file, info);
        }
        renderTray();
      }

      async function uploadPending(p: Pending, file: File, info: { kind: Kind; type: string }) {
        try {
          if (info.kind === 'image') {
            p.thumb = await toDataUrl(await drawScaled(file, 160, 0.7));
            renderTray();
          }
          p.att = await uploadFile(file, info, false, p.thumb);
          p.status = 'ready';
          if (info.kind === 'container' && !pressed(codeBtn)) setPressed(codeBtn, KEY_CODE, true);
        } catch (err) {
          p.status = 'error';
          p.error = (err as Error).message === 'encode' ? 'Görsel okunamadı' : (err as Error).message || 'Yüklenemedi';
        }
        renderTray();
      }

      function renderTray() {
        tray.replaceChildren();
        tray.hidden = pending.length === 0;
        for (const p of pending) {
          const chip = document.createElement('div');
          chip.className = `tray-chip is-${p.status}`;
          if (p.thumb) {
            const img = document.createElement('img');
            img.src = p.thumb;
            img.alt = '';
            chip.append(img);
          }
          const label = document.createElement('span');
          label.className = 'tray-name';
          label.textContent = p.name;
          chip.append(label);
          if (p.status !== 'ready') {
            const state = document.createElement('span');
            state.className = 'tray-state';
            state.textContent = p.status === 'uploading' ? 'yükleniyor…' : p.error ?? 'hata';
            chip.append(state);
          }
          const del = document.createElement('button');
          del.type = 'button';
          del.className = 'tray-del';
          del.setAttribute('aria-label', `${p.name} ekini kaldır`);
          del.textContent = '×';
          del.addEventListener('click', () => {
            if (p.att && !convos.some((c) => refsOf([c]).includes(p.att!.ref))) deleteFiles([p.att.ref]);
            pending = pending.filter((x) => x !== p);
            renderTray();
          });
          chip.append(del);
          tray.append(chip);
        }
      }

      function flashTray(message: string) {
        tray.hidden = false;
        const note = noteEl(message, 'error');
        note.classList.add('w-full');
        tray.append(note);
        setTimeout(() => note.remove(), 3000);
      }

      attachBtn.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', () => {
        if (fileInput.files) addFiles(Array.from(fileInput.files));
        fileInput.value = '';
      });
      input.addEventListener('paste', (e) => {
        const files = Array.from(e.clipboardData?.files ?? []);
        if (files.length) {
          e.preventDefault();
          addFiles(files);
        }
      });
      document.addEventListener('dragover', (e) => {
        if (e.dataTransfer?.types.includes('Files')) {
          e.preventDefault();
          document.body.classList.add('is-dragging');
        }
      });
      document.addEventListener('dragleave', (e) => {
        if (!e.relatedTarget) document.body.classList.remove('is-dragging');
      });
      document.addEventListener('drop', (e) => {
        document.body.classList.remove('is-dragging');
        if (!e.dataTransfer?.files.length || projectDialog.open) return;
        e.preventDefault();
        addFiles(Array.from(e.dataTransfer.files));
      });

      // ─── Voice input (the browser's own speech recognition) ────────────
      type Recognition = {
        lang: string;
        continuous: boolean;
        interimResults: boolean;
        start(): void;
        stop(): void;
        onresult: ((e: { resultIndex: number; results: ArrayLike<{ isFinal: boolean; 0: { transcript: string } }> }) => void) | null;
        onend: (() => void) | null;
        onerror: ((e: { error: string }) => void) | null;
      };
      const SpeechRecognitionCtor = (window as unknown as Record<string, new () => Recognition>).SpeechRecognition ??
        (window as unknown as Record<string, new () => Recognition>).webkitSpeechRecognition;
      const MIC_INSTANT_MS = 1000; // ended this fast with nothing heard: something's wrong
      const MIC_QUIET_LIMIT = 3; // silent sessions in a row before it gives up
      let recognition: Recognition | null = null;
      micBtn.hidden = !SpeechRecognitionCtor;

      let dictating = false; // stays on across the restarts below

      function stopDictation() {
        dictating = false;
        recognition?.stop();
      }
      const MIC_ERRORS: Record<string, string> = {
        'not-allowed': 'Mikrofon izni verilmedi. Tarayıcının site ayarlarından izin ver.',
        'service-not-allowed': 'Bu tarayıcı sesle yazmaya izin vermiyor. Klavyenin mikrofonunu kullanabilirsin.',
        'audio-capture': 'Mikrofon bulunamadı ya da başka bir uygulama kullanıyor.',
        network: 'Ses tanıma servisine ulaşılamadı.',
        'language-not-supported': 'Bu tarayıcı Türkçe ses tanımayı desteklemiyor.',
      };
      // Browsers end a recognition session on their own (phones after every
      // sentence), so it restarts until the person stops it. A session that
      // dies at once with nothing heard is reported instead of looping.
      function listen(base: string) {
        let final = '';
        let quiet = 0;
        const session = () => {
          const rec = new SpeechRecognitionCtor();
          rec.lang = 'tr-TR';
          rec.continuous = !coarse;
          rec.interimResults = true;
          const startedAt = Date.now();
          let heard = false;
          let failed = false;
          rec.onresult = (e) => {
            heard = true;
            quiet = 0;
            let interim = '';
            for (let i = e.resultIndex; i < e.results.length; i++) {
              const r = e.results[i];
              if (r.isFinal) final += `${final && !final.endsWith(' ') ? ' ' : ''}${r[0].transcript.trim()}`;
              else interim += r[0].transcript;
            }
            input.value = base + final + (final && interim ? ' ' : '') + interim;
            autosize();
          };
          rec.onerror = (e) => {
            if (e.error === 'no-speech' || e.error === 'aborted') return;
            failed = true;
            flashTray(MIC_ERRORS[e.error] ?? 'Sesle yazma başlatılamadı.');
          };
          rec.onend = () => {
            recognition = null;
            if (!heard) quiet += 1;
            const instant = !heard && Date.now() - startedAt < MIC_INSTANT_MS;
            if (dictating && !failed && !instant && quiet < MIC_QUIET_LIMIT) return session();
            if (dictating && instant && !failed) flashTray('Mikrofon hemen kapandı. Tarayıcının site ayarlarındaki izni kontrol et.');
            dictating = false;
            micBtn.setAttribute('aria-pressed', 'false');
            input.focus();
          };
          recognition = rec;
          try {
            rec.start();
          } catch {
            recognition = null;
            dictating = false;
            micBtn.setAttribute('aria-pressed', 'false');
          }
        };
        session();
      }
      micBtn.addEventListener('click', () => {
        if (dictating) return stopDictation();
        dictating = true;
        micBtn.setAttribute('aria-pressed', 'true');
        listen(input.value ? `${input.value.replace(/\s+$/, '')} ` : '');
      });

      // Parse a text/event-stream body into JSON event objects.
      async function* readSSE(body: ReadableStream<Uint8Array>) {
        // Cast: TS's DOM lib types TextDecoderStream's input too narrowly.
        const reader = body.pipeThrough(new TextDecoderStream() as TransformStream<Uint8Array, string>).getReader();
        let buffer = '';
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += value;
          let sep: number;
          while ((sep = buffer.search(/\r?\n\r?\n/)) !== -1) {
            const chunk = buffer.slice(0, sep);
            buffer = buffer.slice(sep).replace(/^\r?\n\r?\n/, '');
            const data = chunk
              .split(/\r?\n/)
              .filter((line) => line.startsWith('data:'))
              .map((line) => line.slice(5).trimStart())
              .join('\n');
            if (!data) continue;
            try {
              yield JSON.parse(data);
            } catch {}
          }
        }
      }

      // ─── Pickers and toggles (remembered per device) ───────────────────
      function restorePicker(select: HTMLSelectElement, key: string, allowed: readonly { id: string }[]) {
        const stored = read(key);
        if (stored && allowed.some((o) => o.id === stored)) select.value = stored;
        select.addEventListener('change', () => save(key, select.value));
      }
      const pressed = (btn: HTMLButtonElement) => btn.getAttribute('aria-pressed') === 'true';
      function setPressed(btn: HTMLButtonElement, key: string, on: boolean) {
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        save(key, on ? '1' : '0');
      }
      function restoreToggle(btn: HTMLButtonElement, key: string) {
        btn.setAttribute('aria-pressed', read(key) === '1' ? 'true' : 'false');
        btn.addEventListener('click', () => setPressed(btn, key, !pressed(btn)));
      }
      restorePicker(modelSelect, KEY_MODEL, CHAT_MODELS);
      restorePicker(effortSelect, KEY_EFFORT, CHAT_EFFORTS);
      restoreToggle(webBtn, KEY_WEB);
      restoreToggle(codeBtn, KEY_CODE);

      // ─── Boot ──────────────────────────────────────────────────────────
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/chat/sw.js', { scope: '/chat/' }).catch(() => {});
      }

      async function boot() {
        renderProjectSelect();
        renderConversation();
        if (NOT_CONFIGURED) return showGate('Sohbet servisi henüz yapılandırılmadı.');
        const token = getToken();
        if (!token) return showGate(tokenExpired ? EXPIRED_MSG : '');

        // Chats saved before accounts existed belong to whoever's password
        // is entered next, so ask for it instead of using the saved one.
        if (!read(KEY_USER) && read(KEY_LEGACY_CONVOS)) {
          forgetToken();
          return showGate(MIGRATE_MSG);
        }

        try {
          const res = await fetch(`${CHAT_WORKER_URL}/auth`, { headers: { Authorization: authHeader(token) } });
          if (res.status === 401) {
            forgetToken();
            return showGate('Parola değişmiş. Yeni parolayı gir.');
          }
          const data = res.ok ? await res.json().catch(() => ({})) : {};
          signIn(typeof data.user === 'string' ? data.user : read(KEY_USER) ?? 'partner');
        } catch {
          // Offline: show this device's copy; sync() will report the state.
          const cached = read(KEY_USER);
          if (cached) signIn(cached);
          else showGate('Sunucuya ulaşılamadı. Bağlantını kontrol et.');
        }
      }
      void boot();
    </script>
  </body>
</html>

