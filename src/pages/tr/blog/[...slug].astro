---
import type { GetStaticPaths } from 'astro';
import BlogPostPage from '@views/BlogPostPage.astro';
import { getPosts, slugOf } from '@lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts('tr');
  return posts.map((post) => ({ params: { slug: slugOf(post.id) }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<BlogPostPage post={post} lang="tr" />
