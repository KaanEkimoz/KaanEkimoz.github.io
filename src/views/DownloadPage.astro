---
/**
 * Download: every project that has somewhere to get it (store, website,
 * itch.io) or its source on GitHub, with all of its links under it. Built
 * from the `links` of the projects collection, so a new link shows up here
 * without touching this page.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import BrandIcon from '@components/BrandIcon.astro';
import { getProjects, slugOf } from '@lib/content';
import playEn from '@/assets/badges/google-play-en.png';
import playTr from '@/assets/badges/google-play-tr.png';
import { localizedPath, t, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const GLOBE =
  '<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z"/></svg>';

type Link = { href: string; label: string; kind: string; icon?: string; svg?: string };
// Google's official badge (trimmed of its transparent margin only).
const playBadge = lang === 'tr' ? playTr : playEn;
const playAlt = lang === 'tr' ? "Google Play'den indirin" : 'Get it on Google Play';

const apps = (await getProjects(lang))
  .map((p) => {
    const l = p.data.links;
    const get = [
      l.googlePlay && { href: l.googlePlay, label: 'Google Play', kind: 'play' },
      l.appStore && { href: l.appStore, label: 'App Store', kind: 'apple', icon: 'siApple' },
      l.itchio && { href: l.itchio, label: 'itch.io', kind: 'itch', icon: 'siItchdotio' },
      l.website && { href: l.website, label: t('download.website', lang), kind: 'web', svg: GLOBE },
    ].filter(Boolean) as Link[];
    const source: Link[] = l.github ? [{ href: l.github, label: t('download.source', lang), kind: 'github', icon: 'siGithub' }] : [];
    return { p, get, links: [...get, ...source] };
  })
  .filter((a) => a.links.length > 0)
  // Things people can install first, source-only games after.
  .sort((a, b) => Number(b.get.length > 0) - Number(a.get.length > 0));
---

<BaseLayout lang={lang} title={t('download.metaTitle', lang)} description={t('download.metaDescription', lang)}>
  <div class="wrap page">
    <PageHeader eyebrow={t('download.eyebrow', lang)} title={t('download.title', lang)} subtitle={t('download.subtitle', lang)} />

    <ul class="apps">
      {
        apps.map(({ p, links }) => {
          const { title, coverSquare, coverImage, coverPosition } = p.data;
          const cover = coverSquare ?? coverImage;
          return (
            <li class="app">
              <h2>{title}</h2>
              <a class="thumb" href={localizedPath(`/projects/${slugOf(p.id)}`, lang)} data-project-modal aria-label={title}>
                {cover && (
                  <Image
                    src={cover}
                    alt=""
                    widths={[240, 480, 720]}
                    sizes="(min-width: 1024px) 260px, (min-width: 640px) 33vw, 50vw"
                    style={!coverSquare && coverPosition ? `object-position:${coverPosition}` : undefined}
                  />
                )}
              </a>
              <div class="links">
                {links.map((l) =>
                  l.kind === 'play' ? (
                    <a class="badge" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${title}: ${playAlt}`}>
                      <Image src={playBadge} alt={playAlt} widths={[180, 360]} sizes="180px" />
                    </a>
                  ) : (
                    <a class:list={['get', l.kind]} href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`${title}: ${l.label}`}>
                      {l.icon ? <BrandIcon name={l.icon} size={20} color={false} /> : <Fragment set:html={l.svg} />}
                      <span>{l.label}</span>
                    </a>
                  ),
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 8vw, 88px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .apps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px 32px;
  }
  .app {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  h2 {
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .thumb {
    display: block;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgb(var(--border));
    background: rgb(var(--bg-elev-2));
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.25s;
  }
  :global(html[data-theme='light']) .thumb {
    box-shadow: var(--shadow);
  }
  .thumb:hover {
    border-color: rgb(var(--accent-1) / 0.5);
  }
  .thumb:active {
    transform: scale(0.98);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .links {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  /* Store badge and the coloured buttons share one size (badge is 3.36:1). */
  .badge,
  .get {
    width: min(100%, 180px);
    height: auto;
    aspect-ratio: 3.36;
    border-radius: 9px;
    transition: transform 0.1s ease-out, filter 0.2s;
  }
  .badge :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .get {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 12px;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge:hover,
  .get:hover {
    filter: brightness(1.12);
  }
  .badge:active,
  .get:active {
    transform: scale(0.97);
  }
  .github {
    background: #24292f;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
  .web {
    background: rgb(var(--accent-strong));
  }
  .apple {
    background: #000;
    box-shadow: inset 0 0 0 1px #a6a6a6;
  }
  .itch {
    background: #fa5c5c;
  }
  @media (max-width: 1023px) {
    .apps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px 24px;
    }
  }
  @media (max-width: 639px) {
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 16px;
    }
    .thumb {
      border-radius: 16px;
    }
    h2 {
      font-size: 1rem;
    }
    .get {
      font-size: 0.82rem;
      gap: 6px;
    }
  }
</style>
