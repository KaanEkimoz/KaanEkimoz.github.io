---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import MethodSection from '@components/home/MethodSection.astro';
import CareerSection from '@components/home/CareerSection.astro';
import SkillsSection from '@components/home/SkillsSection.astro';
import EvalsSection from '@components/home/EvalsSection.astro';
import GamesSection from '@components/home/GamesSection.astro';
import ContactSection from '@components/home/ContactSection.astro';
import BlogCard from '@components/BlogCard.astro';
import { getPosts } from '@lib/content';
import { copy, pick } from '@lib/home';
import { localizedPath, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const latestPosts = (await getPosts(lang)).slice(0, 3);
const w = copy.writing;
---

<BaseLayout lang={lang}>
  <HeroSection lang={lang} />
  <MethodSection lang={lang} />
  <CareerSection lang={lang} />
  <SkillsSection lang={lang} />
  <EvalsSection lang={lang} />
  <GamesSection lang={lang} />

  {
    latestPosts.length > 0 && (
      <section class="sec" id="writing">
        <div class="wrap">
          <div class="head" data-fade-in>
            <h2>{pick(w.title, lang)}</h2>
            <a class="link" href={localizedPath('/blog', lang)}>{pick(w.all, lang)}</a>
          </div>
          <div class="posts">
            {latestPosts.map((post) => <BlogCard post={post} lang={lang} />)}
          </div>
        </div>
      </section>
    )
  }

  <ContactSection lang={lang} />
</BaseLayout>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 44px;
  }
  .head h2 {
    font-size: clamp(1.9rem, 3.8vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  @media (max-width: 860px) {
    .head {
      flex-direction: column;
      align-items: start;
    }
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
