---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/ui/Tag.astro';
import LiteYouTube from '@components/LiteYouTube.astro';
import type { Project } from '@lib/content';
import { localizedPath, t, type Lang } from '@lib/i18n';
import { SITE } from '@lib/constants';
import { projectLd } from '@lib/seo';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { Content } = await render(project);
const { title, platform, genres, year, duration, role, description, techStack, links, coverImage, gallery, youtubeId } =
  project.data;

// The cover is a branded marketing asset, not a screenshot: keep it out of
// the Screenshots grid even when `gallery` lists it.
const screenshots = coverImage ? gallery.filter((g) => g.src !== coverImage.src) : gallery;
// Full-size copies for the lightbox (Lightbox.astro); the strip shows small ones.
const fullSize = await Promise.all(
  screenshots.map((s) => getImage({ src: s, width: Math.min(s.width, s.width >= s.height ? 1800 : 900), format: 'webp' })),
);

// Link previews and search engines get the project's cover, cut to 1200×630.
const social = coverImage
  ? new URL((await getImage({ src: coverImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 85 })).src, SITE.url).href
  : undefined;
const ld = projectLd({ title, description, url: new URL(Astro.url.pathname, SITE.url).href, image: social, year, keywords: [platform, ...genres, ...techStack], lang });

// Secondary links, in display order. The live product URL gets the primary button.
const external = [
  links.youtube && { href: links.youtube, label: t('projectDetail.trailer', lang) },
  links.googlePlay && { href: links.googlePlay, label: 'Google Play ↗' },
  links.appStore && { href: links.appStore, label: 'App Store ↗' },
  links.itchio && { href: links.itchio, label: 'itch.io ↗' },
  links.github && { href: links.github, label: 'GitHub ↗' },
].filter((l): l is { href: string; label: string } => Boolean(l));

// Everything below is styled with utilities / global classes only: the
// project modal injects this article's HTML into other pages, where this
// file's scoped CSS would not be loaded.
---

<BaseLayout lang={lang} title={title} description={description} image={social} imageAlt={social ? title : undefined} jsonLd={ld}>
  <article id="project-detail" class="wrap max-w-4xl pt-12 sm:pt-20 pb-16 sm:pb-24">
    <a href={localizedPath('/projects', lang)} data-back class="eyebrow inline-block mb-8 hover:text-accent-1">
      {t('projectDetail.back', lang)}
    </a>

    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-1.5 mb-5">
        <Tag variant="accent">{platform}</Tag>
        {genres.map((g) => <Tag>{g}</Tag>)}
        <Tag>{year}</Tag>
      </div>
      <h1 class="font-display font-medium text-4xl sm:text-5xl tracking-tight text-text-100">{title}</h1>
      <p class="mt-4 text-text-200 text-lg leading-relaxed max-w-2xl">{description}</p>
      {
        (links.website || external.length > 0) && (
          <div class="mt-7 flex flex-wrap gap-2.5">
            {links.website && (
              <a class="btn" href={links.website} target="_blank" rel="noopener noreferrer">
                {t('projectDetail.visitSite', lang)}
              </a>
            )}
            {external.map((l) => (
              <a class="btn btn-ghost" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      youtubeId && (
        <div class="mb-10">
          <LiteYouTube id={youtubeId} title={`${title} — trailer`} />
        </div>
      )
    }

    {
      screenshots.length > 0 && (
        <section class="mb-12">
          <div class="flex items-center justify-between gap-3 mb-4">
            <h2 class="eyebrow">
              {t('projectDetail.screenshots', lang)} <span class="text-text-300">· {screenshots.length}</span>
            </h2>
            {screenshots.length > 2 && (
              <div class="flex gap-2">
                <button type="button" data-shots-prev aria-label={lang === 'tr' ? 'Önceki' : 'Previous'} class="grid place-items-center w-9 h-9 rounded-full border border-border text-text-200 hover:border-accent-1 hover:text-accent-1 transition-colors">‹</button>
                <button type="button" data-shots-next aria-label={lang === 'tr' ? 'Sonraki' : 'Next'} class="grid place-items-center w-9 h-9 rounded-full border border-border text-text-200 hover:border-accent-1 hover:text-accent-1 transition-colors">›</button>
              </div>
            )}
          </div>
          {/* One scrolling row at a fixed height, each shot at its own aspect; a tap opens the lightbox. */}
          <div data-shots class="flex gap-3 overflow-x-auto snap-x snap-mandatory overscroll-x-contain select-none [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {screenshots.map((img, i) => (
              <a
                href={fullSize[i].src}
                data-lightbox
                class="group shrink-0 snap-start h-[190px] sm:h-[300px] rounded-xl border border-border overflow-hidden bg-bg-elev-2 hover:border-accent-1/60 transition-colors"
                style={`aspect-ratio:${img.width}/${img.height}`}
              >
                <Image
                  src={img}
                  alt={`${title} ${i + 1}`}
                  widths={img.width >= img.height ? [400, 800] : [200, 400]}
                  sizes={img.width >= img.height ? '480px' : '140px'}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              </a>
            ))}
          </div>
        </section>
      )
    }

    <dl class="grid sm:grid-cols-[1fr_1fr_2fr] gap-6 py-6 mb-12 border-y border-border">
      <div>
        <dt class="eyebrow mb-1.5">{t('projectDetail.role', lang)}</dt>
        <dd class="text-text-100">{role}</dd>
      </div>
      <div>
        <dt class="eyebrow mb-1.5">{t('projectDetail.timeline', lang)}</dt>
        <dd class="text-text-100">{duration}</dd>
      </div>
      <div>
        <dt class="eyebrow mb-2">{t('projectDetail.techStack', lang)}</dt>
        <dd class="flex flex-wrap gap-1.5">{techStack.map((tech) => <span class="mono-chip">{tech}</span>)}</dd>
      </div>
    </dl>

    <div class="prose-content space-y-4 leading-relaxed max-w-2xl">
      <Content />
    </div>
  </article>
</BaseLayout>
