---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ProjectFilter from '@components/ProjectFilter.astro';
import { getProjects } from '@lib/content';
import { t, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const projects = await getProjects(lang);
const counts = {
  all: projects.length,
  product: projects.filter((p) => p.data.category === 'product').length,
  game: projects.filter((p) => p.data.category === 'game').length,
};
---

<BaseLayout lang={lang} title={t('meta.projectsTitle', lang)} description={t('meta.projectsDescription', lang)}>
  <div class="wrap page">
    <PageHeader eyebrow={t('projectsIndex.eyebrow', lang)} title={t('projectsIndex.title', lang)} subtitle={t('projectsIndex.subtitle', lang)} />

    <ProjectFilter counts={counts} lang={lang} />

    <div class="grid">
      {
        projects.map((project) => {
          const wide = project.data.category === 'product';
          return (
            <div class:list={{ wide }} data-project-category={project.data.category}>
              <ProjectCard project={project} lang={lang} wide={wide} />
            </div>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 8vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .wide {
    grid-column: span 3;
  }
  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 639px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .wide {
      grid-column: auto;
    }
  }
</style>
