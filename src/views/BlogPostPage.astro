---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/ui/Tag.astro';
import type { Post } from '@lib/content';
import { BCP47, localizedPath, t, type Lang } from '@lib/i18n';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;

const fmt = (d: Date, month: 'long' | 'short') =>
  d.toLocaleDateString(BCP47[lang], { year: 'numeric', month, day: 'numeric' });
---

<BaseLayout lang={lang} title={title} description={description}>
  <article class="wrap max-w-3xl page">
    <a href={localizedPath('/blog', lang)} class="eyebrow back">{t('blogIndex.back', lang)}</a>

    <header>
      <div class="text">
        <p class="date">
          <time datetime={pubDate.toISOString()}>{fmt(pubDate, 'long')}</time>
          {updatedDate && <span> · {t('blogIndex.updated', lang)} {fmt(updatedDate, 'short')}</span>}
        </p>
        <h1>{title}</h1>
        <p class="desc">{description}</p>
        {tags.length > 0 && <div class="tags">{tags.map((tag) => <Tag>{tag}</Tag>)}</div>}
      </div>
      {
        heroImage && (
          <div class="img">
            <Image src={heroImage} alt="" width={448} height={252} loading="eager" />
          </div>
        )
      }
    </header>

    <div class="prose-content space-y-4 leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 8vw, 88px);
  }
  .back {
    display: inline-block;
    margin-bottom: 32px;
  }
  .back:hover {
    color: rgb(var(--accent-1));
  }
  header {
    display: flex;
    gap: 28px;
    align-items: start;
    padding-bottom: 32px;
    margin-bottom: 40px;
    border-bottom: 1px solid rgb(var(--border));
  }
  .text {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 12px;
  }
  .date {
    font: 0.76rem 'JetBrains Mono', ui-monospace, monospace;
    color: rgb(var(--accent-1));
  }
  .date span {
    color: rgb(var(--text-300));
  }
  h1 {
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .desc {
    color: rgb(var(--text-200));
    font-size: 1.05rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .img {
    flex: none;
    width: 224px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgb(var(--border));
  }
  .img :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  @media (max-width: 639px) {
    header {
      flex-direction: column-reverse;
    }
    .img {
      width: 100%;
    }
  }
</style>
