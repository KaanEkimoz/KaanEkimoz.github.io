---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import BlogCard from '@components/BlogCard.astro';
import { getPosts } from '@lib/content';
import { t, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={t('meta.blogTitle', lang)} description={t('meta.blogDescription', lang)}>
  <div class="wrap page">
    <PageHeader eyebrow={t('blogIndex.eyebrow', lang)} title={t('blogIndex.title', lang)} subtitle={t('blogIndex.subtitle', lang)} />

    {
      posts.length > 0 ? (
        <div class="list">
          {posts.map((post) => (
            <BlogCard post={post} lang={lang} variant="row" />
          ))}
        </div>
      ) : (
        <p class="panel empty">{t('blogIndex.empty', lang)}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(48px, 8vw, 88px);
  }
  .list {
    border-bottom: 1px solid rgb(var(--border));
  }
  .empty {
    padding: 32px;
    text-align: center;
    color: rgb(var(--text-300));
  }
</style>
